# ---------------------------------------------------------------------------
# ContinuityOS live medium package list (archiso)
#
# This list builds the *live* environment that also acts as the installer
# medium. Keep it lean: every package here is downloaded into the squashfs and
# held in RAM at boot. The full desktop experience is installed onto the target
# system by /opt/continuityos/install.sh, which also handles the AUR phase.
#
# Packages unavailable in the current official repositories are supplied by
# install.sh --with-aur on the installed system; the live shell remains usable
# without these optional UI/gaming extras:
#   vkbasalt, lib32-sdl2, plus the separately managed launcher apps
# (proton-ge-custom-bin | proton-cachyos-slr, gearlever, photocraft, filmcraft,
# winboat, freebuff-bin).
# ---------------------------------------------------------------------------

# --- base -------------------------------------------------------------------
base
linux-zen
linux-zen-headers
linux-firmware
mkinitcpio
mkinitcpio-archiso
archiso
pacman
sudo
dosfstools
e2fsprogs
cryptsetup
lvm2
btrfs-progs
zstd
xz
tar
rsync
jq
curl
wget
git
nano
vim
less
which
procps-ng
util-linux
pciutils
usbutils
dmidecode
man-db
man-pages
openssl
gnupg
reflector
haveged
# arch-chroot lives here, and continuity-installer uses it to run install.sh
# inside the target after archinstall has written it. archiso pulls it in
# anyway; naming it keeps that dependency honest.
arch-install-scripts

# --- boot / live medium (UEFI systemd-boot only) ----------------------------
efibootmgr
efivar
edk2-shell
memtest86+
terminus-font
libisoburn
squashfs-tools
# mkinitcpio's archiso hooks (memdisk, archiso_pxe_nbd, archiso_pxe_nfs) call
# these binaries at image build time; without them mkarchiso fails at initramfs.
syslinux
nbd
mkinitcpio-nfs-utils
pv

