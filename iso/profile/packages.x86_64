# --- live installer (continuity-installer) ----------------------------------
# archinstall does the part of an installation that must not be improvised:
# partitioning, mkfs, the base system, the kernel, the bootloader. The
# ContinuityOS stack is installed into the target afterwards by the payload's
# own install.sh, inside its chroot — the package lists and the GPU detection
# therefore stay in one place and cannot drift from the installed system.
archinstall
# zenity is the installer's whole interface (and the first-run wizard's file
# picker), so the live medium must have it.
zenity

# --- session plumbing ------------------------------------------------------
networkmanager
# greetd launches the session: [initial_session] in /etc/greetd/config.toml runs
# the ContinuityOS desktop with NO greeter at boot, which is the point of this
# medium. tuigreet is the screen that appears after a logout; agreety ships with
# greetd itself and is the greeter of last resort.
greetd
greetd-tuigreet
network-manager-applet
iwd
bluez
bluez-utils
blueman
pipewire
pipewire-pulse
pipewire-alsa
pipewire-jack
wireplumber
pavucontrol
playerctl
brightnessctl
power-profiles-daemon
upower
xdg-user-dirs
flatpak
xdg-desktop-portal-gtk

# --- theming / assets ------------------------------------------------------
papirus-icon-theme
ttf-jetbrains-mono-nerd
noto-fonts
noto-fonts-emoji
inter-font
ttf-dejavu
adobe-source-sans-fonts
hicolor-icon-theme
gtk3
gtk4
nwg-look
kvantum
qt6ct
adwaita-cursors
# rsvg-convert turns assets/wallpapers/*.svg into the PNGs hyprpaper reads;
# without it install.sh installs the SVGs and no wallpaper ever appears.
librsvg
# Bibata cursors (AUR: bibata-cursor-theme) are installed by install.sh --with-aur

