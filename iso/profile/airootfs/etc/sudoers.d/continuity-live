# ---------------------------------------------------------------------------
# ContinuityOS live medium — the desktop user may install without a password.
#
# The live account has no password (see /etc/sysusers.d/continuity-live.conf),
# so `sudo` could never satisfy a prompt, and the guided installer has to
# partition a disk and run archinstall. Without this rule the installer would
# be unusable from the desktop, which is the only interface this medium has.
#
# This file exists ONLY on the live medium. It is never installed onto a target:
# install.sh --system writes the ContinuityOS CLI, the session and /etc files,
# and nothing in that path copies iso/profile/airootfs/etc/sudoers.d anywhere.
# The account created by archinstall has a real password and gets sudo the
# ordinary way, through wheel.
# ---------------------------------------------------------------------------

continuity ALL=(ALL:ALL) NOPASSWD: ALL
