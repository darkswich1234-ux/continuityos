[Trigger]
# Any change to a compatibility layer can change which Steam Linux Runtime
# (steamrt2/Soldier, steamrt3/Sniper, steamrt4) a Proton build requires, or
# invalidate an already-extracted runtime tree. Re-checking after the transaction
# is what stops the classic "steamrt3 validation failed" surprise at launch time.
Operation = Install
Operation = Upgrade
Operation = Remove
Type = Package
Target = umu-launcher
Target = proton-ge-custom-bin
Target = proton-cachyos-slr
Target = wine
Target = wine-staging

[Action]
Description = ContinuityOS: validating the Steam Linux Runtime used by umu-run...
When = PostTransaction
# NOTE: ALPM runs hooks as root, with root's environment. This script therefore
# resolves $HOME to /root and will report "no local source" rather than guessing a
# user's prefix root — which is the honest thing to do. The user-facing repair
# happens at the next login via continuity-umu-seed.service (user unit) and on
# demand via `continuity-umu-verify --seed`. Keeping the hook here means a machine
# with no graphical session still learns about a mismatched runtime in the journal.
Exec = /usr/local/bin/continuity-umu-verify --quiet --seed
