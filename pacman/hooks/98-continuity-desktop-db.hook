[Trigger]
# The desktop entry and MIME databases cache package-provided .desktop files and
# mime-type XML. Upgrading the packages that own those caches (or the icon theme
# the launchers resolve against) leaves the caches stale until something rebuilds
# them — which is exactly how a freshly installed .exe handler appears to "not
# exist" right after an update.
Operation = Install
Operation = Upgrade
Operation = Remove
Type = Package
Target = desktop-file-utils
Target = hicolor-icon-theme
Target = shared-mime-info

[Action]
Description = ContinuityOS: refreshing desktop entry, icon and MIME databases...
When = PostTransaction
Exec = /usr/bin/update-desktop-database -q
Exec = /usr/bin/update-mime-database /usr/share/mime
