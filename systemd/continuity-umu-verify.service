[Unit]
Description=ContinuityOS: validate the Steam Linux Runtime (check only)
Documentation=file:///usr/local/share/doc/continuityos/ARCHITECTURE.md
# Triggered by continuity-umu-verify.timer. This unit only *checks* — it never
# downloads, extracts or symlinks anything, so it is safe to run while a game is
# playing and safe to run on a metered connection. Repair is the job of
# continuity-umu-seed.service (login) and of the pacman hook.

[Service]
Type=oneshot
# 0 = all present runtimes valid, 1 = something is invalid or missing.
# A non-zero result here is informational: it is surfaced in the journal and in
# `continuity-umu-verify --check`, not as a failed user session.
SuccessExitStatus=0 1
ExecStart=/usr/local/bin/continuity-umu-verify --quiet --check
TimeoutStartSec=60
# Pure read/verify work, so keep it out of the way of the compositor.
IOSchedulingClass=idle
CPUWeight=10
IOWeight=10

[Install]
# Normally pulled in by the timer; WantedBy is intentionally absent so nobody
# enables this unit directly by mistake.
