[Unit]
Description=ContinuityOS: seed and validate the Steam Linux Runtime used by umu-run
Documentation=file:///usr/local/share/doc/continuityos/ARCHITECTURE.md
# The runtime tree lives under $HOME (~/.local/share/umu), so this must be a user
# unit. It runs at login because umu may need to repair or (re)download a steamrt*
# variant before the first double-clicked .exe of the session.
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=oneshot
# Never block or fail the session:
#   0 = runtime set valid, 1 = a runtime is invalid, 2 = invalid and nothing local
#   to repair from (the first launch then downloads it). All three mean "carry on".
SuccessExitStatus=0 1 2
ExecStart=/usr/local/bin/continuity-umu-verify --quiet --seed
# Repairing a runtime can mean unpacking a couple of GB.
TimeoutStartSec=600
RemainAfterExit=no
# Heavy I/O, low priority: this must not fight a game that is already running.
IOSchedulingClass=idle
CPUWeight=20
IOWeight=20
Nice=10

[Install]
WantedBy=graphical-session.target
