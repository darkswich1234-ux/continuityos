[Unit]
Description=ContinuityOS: WinBoat Windows application bridge (optional)
Documentation=https://github.com/TibixDev/winboat
# WinBoat boots a real Windows guest inside a container and streams individual
# applications to the Wayland desktop over FreeRDP. It is the escape hatch for
# enterprise utilities that neither Proton nor Wine can run, so install.sh only
# drops this unit in when the user passes --with-winboat: it needs /dev/kvm, a
# Windows installation medium/image and several GB of disk.
#
# ASSUMPTION (deliberately documented, not hidden): upstream currently ships no
# systemd unit and expects the desktop GUI to be launched by the user. This unit
# is therefore a thin supervisor that starts the backend binary once the network
# is up; it is installed but NOT enabled by default. If upstream ever ships its
# own unit (winboat.service), prefer that one and delete this file.
ConditionPathExists=/usr/bin/winboat
After=network-online.target
Wants=network-online.target
# The container backend needs the host's virtualisation stack.
After=libvirtd.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/winboat
Restart=on-failure
RestartSec=5
# A Windows guest is memory hungry; fail fast rather than thrash the host.
MemoryMax=90%
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
