#!/usr/bin/env bash
# ContinuityOS — optional end4-pC Quickshell overlay scaffold.
# This stages a pinned upstream checkout; it never installs the base shell,
# changes Hyprland configuration, or kills existing Quickshell processes.
set -uo pipefail

PROG="${0##*/}"
REPO_URL="https://github.com/pctrade/end4-pC.git"
PINNED_COMMIT="4de3f593cb220194fd2f87c1e344b775482ad9aa"

usage() {
  cat <<'EOF'
continuity-end4-pc — private end4-pC Quickshell overlay scaffold

USAGE
  continuity-end4-pc install   # clone the pinned overlay (no base setup)
  continuity-end4-pc status    # inspect the checkout and prerequisite hints
  continuity-end4-pc launch    # run qs -c end4-pC and append output to its log

The illogical-impulse base must be installed separately. This tool does not
change your default shell, modify Hyprland files, or stop other `qs` processes.
EOF
}

say() { printf '%s: %s\n' "$PROG" "$*" >&2; }
die() { say "error: $*"; exit 1; }

[ -n "${HOME:-}" ] || die 'HOME is not set'
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
case "$CONFIG_HOME" in
  /*) ;;
  *) die 'XDG_CONFIG_HOME must be an absolute path' ;;
esac
QUICKSHELL_DIR="$CONFIG_HOME/quickshell"
OVERLAY_DIR="$QUICKSHELL_DIR/end4-pC"
BASE_DIR="$QUICKSHELL_DIR/ii"
STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
LOG_FILE="$STATE_HOME/continuity/end4-pC.log"

checkout_commit() {
  git -C "$OVERLAY_DIR" rev-parse HEAD 2>/dev/null
}

checkout_origin() {
  git -C "$OVERLAY_DIR" remote get-url origin 2>/dev/null
}

status() {
  if [ ! -e "$OVERLAY_DIR" ] && [ ! -L "$OVERLAY_DIR" ]; then
    printf 'overlay=not-installed\npath=%s\npinned_commit=%s\n' "$OVERLAY_DIR" "$PINNED_COMMIT"
    return 0
  fi

  local commit origin
  commit="$(checkout_commit || true)"
  origin="$(checkout_origin || true)"
  printf 'path=%s\ncommit=%s\norigin=%s\npinned_commit=%s\n' \
    "$OVERLAY_DIR" "${commit:-not-a-git-checkout}" "${origin:-unknown}" "$PINNED_COMMIT"
  if [ "$commit" = "$PINNED_COMMIT" ] && [ "$origin" = "$REPO_URL" ]; then
    printf 'overlay=installed-pinned\n'
  else
    printf 'overlay=present-but-not-the-pinned-upstream-checkout\n'
    return 1
  fi
  if [ -d "$BASE_DIR" ]; then
    printf 'base=ii-config-detected\n'
  else
    printf 'base=not-detected (install illogical-impulse separately)\n'
  fi
  if command -v qs >/dev/null 2>&1; then
    printf 'quickshell=available\n'
  else
    printf 'quickshell=missing\n'
  fi
}

install_overlay() {
  command -v git >/dev/null 2>&1 || die 'git is required to clone the overlay'
  if [ -e "$OVERLAY_DIR" ] || [ -L "$OVERLAY_DIR" ]; then
    local existing_commit existing_origin
    existing_commit="$(checkout_commit || true)"
    existing_origin="$(checkout_origin || true)"
    if [ "$existing_commit" = "$PINNED_COMMIT" ] && [ "$existing_origin" = "$REPO_URL" ]; then
      say "pinned overlay already exists at $OVERLAY_DIR; leaving it unchanged"
      return 0
    fi
    die "destination already exists and is not the pinned upstream checkout; leaving it untouched: $OVERLAY_DIR"
  fi

  mkdir -p "$QUICKSHELL_DIR" || die "cannot create $QUICKSHELL_DIR"
  local staging
  staging="$(mktemp -d "$QUICKSHELL_DIR/.end4-pC.XXXXXX")" || die 'cannot create a staging directory'
  local clone_args=(clone --no-checkout)
  if git clone -h 2>&1 | grep -q -- '--filter'; then
    clone_args=(clone --filter=blob:none --no-checkout)
  fi
  if ! git "${clone_args[@]}" "$REPO_URL" "$staging/checkout"; then
    rm -rf -- "$staging"
    die 'upstream clone failed'
  fi
  if ! git -C "$staging/checkout" fetch --depth 1 origin "$PINNED_COMMIT"; then
    rm -rf -- "$staging"
    die "could not fetch pinned commit $PINNED_COMMIT"
  fi
  if ! git -C "$staging/checkout" checkout --detach "$PINNED_COMMIT"; then
    rm -rf -- "$staging"
    die "pinned commit $PINNED_COMMIT is unavailable"
  fi

  local actual origin
  actual="$(git -C "$staging/checkout" rev-parse HEAD 2>/dev/null || true)"
  origin="$(git -C "$staging/checkout" remote get-url origin 2>/dev/null || true)"
  if [ "$actual" != "$PINNED_COMMIT" ] || [ "$origin" != "$REPO_URL" ]; then
    rm -rf -- "$staging"
    die 'the staged checkout failed commit/origin verification'
  fi
  if [ -e "$OVERLAY_DIR" ] || [ -L "$OVERLAY_DIR" ] || ! mv -T -- "$staging/checkout" "$OVERLAY_DIR"; then
    rm -rf -- "$staging"
    die "destination appeared during install or could not be moved into place: $OVERLAY_DIR"
  fi
  rm -rf -- "$staging"
  say "installed pinned end4-pC at $OVERLAY_DIR"
  say 'base setup is separate; read docs/END4-PC.md before launching'
}

launch_overlay() {
  [ -d "$OVERLAY_DIR/.git" ] || die "overlay is not installed; run '$PROG install'"
  local commit origin
  commit="$(checkout_commit || true)"
  origin="$(checkout_origin || true)"
  [ "$commit" = "$PINNED_COMMIT" ] && [ "$origin" = "$REPO_URL" ] || \
    die 'refusing to launch: checkout does not match the pinned upstream origin and commit'
  command -v qs >/dev/null 2>&1 || die 'qs is missing; install Quickshell as part of the base setup'
  if [ ! -d "$BASE_DIR" ]; then
    say 'warning: ~/.config/quickshell/ii was not detected; upstream requires illogical-impulse to be installed and running'
  fi
  umask 077
  mkdir -p "${LOG_FILE%/*}" || die "cannot create ${LOG_FILE%/*}"
  touch "$LOG_FILE" || die "cannot write $LOG_FILE"
  chmod 600 "$LOG_FILE" 2>/dev/null || true
  say "launching qs -c end4-pC; output is appended to $LOG_FILE"
  set -o pipefail
  qs -c end4-pC 2>&1 | tee -a "$LOG_FILE"
}

case "${1:-}" in
  install) install_overlay ;;
  status) status ;;
  launch) launch_overlay ;;
  -h|--help|help|'') usage ;;
  *) usage >&2; die "unknown command '$1'" ;;
esac
