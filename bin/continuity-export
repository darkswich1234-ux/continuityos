#!/usr/bin/env bash
# ContinuityOS setup transfer — move a whole setup between machines, verified.
#
# A ContinuityOS setup is not one config file. It is the Windows app prefixes
# (each a complete Wine/Proton bottle), the launchers generated for the programs
# inside them, the icons those launchers point at, and the choices the first-run
# wizard recorded. Rebuilding that by hand on a second machine means
# reinstalling every Windows app from scratch, which is what this tool avoids.
#
#   continuity-export export [--out FILE]     pack this machine's setup
#   continuity-export import ARCHIVE          restore a setup here (no clobber)
#   continuity-export inspect ARCHIVE         what is inside an archive
#   continuity-export list                    what this machine's setup holds
#
# ARCHIVE FORMAT (SETUP_FORMAT=1) — one tar stream, zstd when available else
# gzip, whose top directory is continuity-setup/:
#
#   continuity-setup/manifest.conf      flat key=value; never shell-evaluated
#   continuity-setup/checksums.sha256   sha256sum format, relative to payload/
#   continuity-setup/payload/
#     prefix-root/<slug>/…              the Wine/Proton bottles
#     launchers/<slug>/<name>.desktop   launchers, in their real per-slug layout
#     state/wizard.state                first-run choices (and wizard.done)
#     state/gaming-mode.enabled         the session-style marker
#     state/icons/<slug>/…              the icons those launchers point at
#     config/environment.conf           engine preferences
#     config/region.conf                locale/keyboard/timezone, when set
#
# Deliberately NOT in the archive: Steam, Proton installations and game libraries.
# Those are machine state and large; the target installs Steam/Proton separately.
# The launcher layout is preserved because `continuity-prefix launchers
# <slug> --list` and the app drawer both read exactly that layout.
#
# INTEGRITY AND SAFETY
#   * SETUP_FORMAT must be 1. A newer format is refused rather than
#     half-understood, because a silently-ignored field is worse than an error.
#   * Nothing is extracted into place until every checksum has verified, and
#     verification happens in a cache directory — never in $HOME.
#   * An existing prefix, launcher or icon is never overwritten. --merge (the
#     default) leaves it alone and reports it as skipped; --replace moves the old
#     copy to ~/.local/state/continuity/replaced/<timestamp>-<name> first.
#     Nothing is ever deleted, and replacements are kept out of the prefix root
#     so they cannot show up as phantom apps in `continuity-prefix list`.
#   * $HOME is rewritten in the imported launchers' Exec=/Path=/Icon= lines only.
#     Those are the only files in a setup that embed an absolute home path: a
#     prefix's registry is C:\-relative, so it is moved verbatim.
set -euo pipefail

_lib="${CONTINUITY_LIB:-}"
if [ -z "$_lib" ]; then
  for _p in \
    "$(cd "$(dirname "$0")" 2>/dev/null && pwd)/continuity-common.sh" \
    "$(cd "$(dirname "$0")/.." 2>/dev/null && pwd)/lib/continuity-common.sh" \
    /usr/local/lib/continuity/continuity-common.sh \
    /usr/lib/continuity/continuity-common.sh; do
    [ -r "$_p" ] && { _lib="$_p"; break; }
  done
fi
[ -r "${_lib:-}" ] || { echo "continuity-export: cannot locate continuity-common.sh" >&2; exit 1; }
# shellcheck source=../lib/continuity-common.sh
. "$_lib"

PROG="${0##*/}"
ACTION="${1:-}"
if [ $# -ge 1 ]; then shift; fi

WORK=""
cleanup() { [ -n "$WORK" ] && [ -d "$WORK" ] && rm -rf -- "$WORK" 2>/dev/null; }
trap cleanup EXIT INT TERM

usage() {
  cat <<'EOF'
continuity-export — move an entire ContinuityOS setup between machines

USAGE
  continuity-export export [OPTIONS]
  continuity-export import ARCHIVE [--replace|--merge] [--dry-run] [--yes]
  continuity-export inspect ARCHIVE
  continuity-export list

EXPORT
  --out PATH          Archive path, or a directory to put the default name in.
                      Default: ~/continuity-setup-<host>-<date>.tar.zst
  --no-prefixes       Leave the Windows app prefixes out.
  --no-launchers      Leave the generated launchers and their icons out.
  --no-preferences    Leave wizard state and engine preferences out.
  --dry-run           Print the plan, item counts and sizes; change nothing.
  --yes               Overwrite an existing archive without asking.

IMPORT
  --merge             Default. Keep anything that already exists here.
  --replace           Move an existing prefix/launcher/icon aside, then restore
                      the archived copy over it (nothing is deleted).
  --dry-run           Verify the archive and print the plan; write nothing.
  --yes               Do not ask anything (import never prompts).

WHAT MOVES
  Windows app prefixes, their launchers and icons, the first-run wizard's state,
  the gaming-mode marker, and the engine/preference files.

WHAT DOES NOT MOVE
  Steam itself, Proton installations and game libraries — all machine state.
  After importing, register a game library
  with: continuity-wizard import-steam

ENVIRONMENT
  CONTINUITY_EXPORT_ZSTD_LEVEL  zstd level for new archives (default: 10)
EOF
}

# ---------------------------------------------------------------------------
# generic helpers
# ---------------------------------------------------------------------------
work_dir() {
  local base="${XDG_CACHE_HOME:-$HOME/.cache}/continuity-export"
  mkdir -p "$base" 2>/dev/null || base="/tmp"
  mktemp -d "$base/work.XXXXXX" 2>/dev/null || continuity_die "cannot create a working directory under $base"
}

path_kb() {
  local k
  # `|| true`: a prefix can disappear (or contain an unreadable corner) between
  # being listed and being measured, and pipefail would otherwise fail the whole
  # assignment — and with it the script — over a size that is only cosmetic.
  k="$(du -sk -- "$1" 2>/dev/null | cut -f1 || true)"
  printf '%s' "${k:-0}"
}

entry_count() {
  local n
  # `|| true`: a prefix with one unreadable corner must not abort an export, and
  # under pipefail a failing find would otherwise take the whole script with it.
  n="$(find "$1" -type f 2>/dev/null | awk 'END { print NR }' || true)"
  printf '%s' "${n:-0}"
}

human_size() {
  if continuity_have du; then du -sh -- "$1" 2>/dev/null | cut -f1; else printf '?'; fi
}

fmt_kb() {
  awk -v k="${1:-0}" 'BEGIN {
    split("KB MB GB TB", u, " ");
    i = 1;
    while (k >= 1024 && i < 4) { k /= 1024; i++ }
    if (i == 1) printf "%d %s", k, u[i]; else printf "%.1f %s", k, u[i];
  }'
}

free_kb() {
  df -Pk -- "$1" 2>/dev/null | awk 'NR == 2 { print $4 }'
}

# Compression is decided by content first and name second: a .tar.zst that was
# really written by older gzip must still import.
archive_compression() {
  # CONTENT FIRST, name second. A name only says what somebody intended: an
  # archive written on a machine without zstd is gzip inside whatever filename
  # was asked for, and trusting the extension made the tool demand a binary it
  # did not need (and refuse an archive it could perfectly well read).
  local f="$1" magic
  magic="$(od -An -tx1 -N4 -- "$f" 2>/dev/null | tr -d ' \n')"
  case "$magic" in
    28b52ffd*) printf 'zstd'; return 0 ;;
    1f8b*)     printf 'gzip'; return 0 ;;
  esac
  case "${f##*.}" in
    zst|zstd) printf 'zstd' ;;
    gz|tgz)   printf 'gzip' ;;
    *)        printf 'tar' ;;
  esac
}

extract_archive_to() {
  local dir="$1" archive="$2"
  mkdir -p "$dir" || continuity_die "cannot create $dir"
  case "$(archive_compression "$archive")" in
    zstd)
      continuity_require zstd "sudo pacman -S zstd"
      zstd -dc -- "$archive" | tar -C "$dir" -xf -
      ;;
    gzip) tar -C "$dir" -xzf "$archive" ;;
    tar)  tar -C "$dir" -xf "$archive" ;;
  esac
}

# Extract named members only — what `inspect` and a dry-run plan need, without
# paying for a multi-gigabyte payload.
extract_members() {
  local dir="$1" archive="$2"
  shift 2
  mkdir -p "$dir" || continuity_die "cannot create $dir"
  case "$(archive_compression "$archive")" in
    zstd)
      continuity_require zstd "sudo pacman -S zstd"
      zstd -dc -- "$archive" | tar -C "$dir" -xf - "$@"
      ;;
    gzip) tar -C "$dir" -xzf "$archive" "$@" ;;
    tar)  tar -C "$dir" -xf "$archive" "$@" ;;
  esac
}

manifest_get() {
  awk -F= -v k="$2" 'index($0, k "=") == 1 { sub(/^[^=]*=/, ""); print; exit }' "$1"
}

checksums_line_count() {
  local n
  # Absolute-safe: a missing or unreadable checksum list must read as 0, never
  # abort the caller that is trying to report on it.
  n="$(awk 'NF { n++ } END { print n + 0 }' "$1" 2>/dev/null || true)"
  printf '%s' "${n:-0}"
}

verify_checksums() {
  # verify_checksums PAYLOAD_DIR [LIST]
  # The list is a sibling of payload/ (continuity-setup/checksums.sha256) while
  # its entries are relative to payload/, so the two paths are separate arguments
  # and the check runs from inside the payload directory.
  local dir="$1" list="${2:-}" out="" rc=0
  [ -n "$list" ] || list="$dir/checksums.sha256"
  [ -r "$list" ] || {
    continuity_error "the archive has no checksums.sha256 — refusing to trust it"
    return 1
  }
  if continuity_have sha256sum; then
    out="$( ( cd "$dir" && sha256sum -c --quiet "$list" ) 2>&1 )" || rc=1
  elif continuity_have shasum; then
    out="$( ( cd "$dir" && shasum -a 256 -c "$list" ) 2>&1 )" || rc=1
  else
    continuity_error "no sha256 tool (sha256sum or shasum) — cannot verify the archive"
    return 1
  fi
  if [ "$rc" != "0" ]; then
    continuity_error "integrity check failed:"
    awk 'NR <= 8 { print "    " $0 }' <<<"$out" >&2
    return 1
  fi
  return 0
}

# Prefer hardlinks into the staging directory: a prefix can be tens of gigabytes
# and the archive only ever reads it, so copying the bytes out and back in is
# pure waste. Cross-filesystem staging falls back to a real copy, and a partial
# hardlink attempt is removed first so `cp -a` cannot nest the target inside it.
copy_tree() {
  local src="$1" dst_dir="$2" name
  name="$(basename -- "$src")"
  mkdir -p "$dst_dir" || return 1
  if cp -al -- "$src" "$dst_dir" 2>/dev/null; then return 0; fi
  rm -rf -- "$dst_dir/$name"
  cp -a -- "$src" "$dst_dir"
}

copy_file() {
  local src="$1" dst="$2"
  mkdir -p "$(dirname -- "$dst")" || return 1
  cp -a -- "$src" "$dst"
}

# Keep a displaced copy outside the prefix root: anything left inside it would
# be listed as a Windows application by continuity-prefix list.
move_aside() {
  local path="$1" name="$2" stamp dest
  stamp="$(date +%Y%m%dT%H%M%S)"
  name="$(printf '%s' "$name" | tr '/' '_')"
  dest="$CONTINUITY_STATE_DIR/replaced/${stamp}-${name}"
  mkdir -p "$CONTINUITY_STATE_DIR/replaced" || return 1
  mv -- "$path" "$dest" || return 1
  printf '%s' "$dest"
}

# Rewrite an absolute home path, but only in the keys that carry paths. Name=
# and Comment= may legitimately mention a directory; rewriting prose would be
# corruption, not portability.
rewrite_desktop_paths() {
  local file="$1" old="$2" new="$3" tmp
  [ -n "$old" ] || return 0
  [ "$old" != "$new" ] || return 0
  [ -r "$file" ] || return 0
  tmp="$(mktemp)" || return 1
  awk -v old="$old" -v new="$new" '
    BEGIN {
      pat = old
      gsub(/[][(){}.*+?^$|\\]/, "\\\\&", pat)
      repl = new
      gsub(/\\/, "\\\\", repl)
      gsub(/&/, "\\&", repl)
    }
    /^(Exec|Path|Icon)=/ { gsub(pat, repl) }
    { print }
  ' "$file" >"$tmp" && mv -- "$tmp" "$file"
  chmod 0644 "$file" 2>/dev/null || true
}

# Write KEY=VALUE into a config file, replacing the first line that assigns or
# comments out that key (the comment-out case matters: environment.conf ships
# "#CONTINUITY_PROTONPATH=…" as documentation) and appending when there is none.
set_conf_key() {
  local file="$1" key="$2" value="$3" tmp
  case "$key" in
    ''|*[!A-Za-z0-9_]*|[0-9]*) continuity_warn "refusing to write a malformed key '$key' into $file"; return 0 ;;
  esac
  tmp="$(mktemp)" || return 1
  awk -v k="$key" -v v="$value" '
    BEGIN { done = 0 }
    {
      if (done == 0) {
        t = $0
        sub(/^[[:space:]]+/, "", t)
        if (index(t, k "=") == 1) { print k "=" v; done = 1; next }
        t2 = t
        sub(/^#+[[:space:]]*/, "", t2)
        if (index(t2, k "=") == 1) { print k "=" v; done = 1; next }
      }
      print
    }
    END { if (done == 0) print k "=" v }
  ' "$file" >"$tmp" && mv -- "$tmp" "$file"
  chmod 0600 "$file" 2>/dev/null || true
}

# Merge one config file key-by-key, printing "KEY VALUE" for every key written.
# Only identifiers are accepted, so an archive can never inject shell into a file
# that continuity_load_env later sources.
merge_conf_file() {
  local src="$1" target="$2" line key value
  [ -r "$src" ] || return 0
  if [ ! -e "$target" ]; then
    mkdir -p "$(dirname -- "$target")" 2>/dev/null || true
    : >"$target"
    chmod 0600 "$target" 2>/dev/null || true
  fi
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line%$'\r'}"
    case "$line" in ''|'#'*) continue ;; *=*) ;; *) continue ;; esac
    key="${line%%=*}"
    value="${line#*=}"
    case "$key" in
      ''|*[!A-Za-z0-9_]*|[0-9]*) continue ;;
    esac
    set_conf_key "$target" "$key" "$value"
    # One line per merged key; the caller prints it as-is so a value containing
    # spaces survives intact.
    printf '%s=%s\n' "$key" "$value"
  done <"$src"
  return 0
}

# One place that knows the payload layout, so export and import cannot drift.
pref_entries() {
  printf '%s\n' \
    "config/environment.conf|$CONTINUITY_CONFIG_DIR/environment.conf" \
    "config/region.conf|$CONTINUITY_CONFIG_DIR/region.conf" \
    "state/wizard.state|$CONTINUITY_STATE_DIR/wizard.state" \
    "state/wizard.done|$CONTINUITY_STATE_DIR/wizard.done" \
    "state/gaming-mode.enabled|$CONTINUITY_STATE_DIR/gaming-mode.enabled"
}

default_archive_name() {
  local host ext
  host="$(uname -n 2>/dev/null || printf 'host')"
  host="$(printf '%s' "$host" | tr -c 'A-Za-z0-9._-' '-')"
  ext=".tar.gz"
  continuity_have zstd && ext=".tar.zst"
  printf 'continuity-setup-%s-%s%s' "$host" "$(date +%Y-%m-%d)" "$ext"
}

setup_inventory() {
  # Sets PREFIX_DIRS / LAUNCHER_RELS / PREF_SRC / PREF_DEST / ICON_DIR.
  PREFIX_DIRS=()
  LAUNCHER_RELS=()
  PREF_SRC=()
  PREF_DEST=()
  ICON_DIR=""
  local d f entry dest src
  if [ "$INCLUDE_PREFIXES" = "1" ] && [ -d "$CONTINUITY_PREFIX_ROOT" ]; then
    while IFS= read -r d; do
      [ -n "$d" ] || continue
      PREFIX_DIRS+=("$d")
    done < <(find "$CONTINUITY_PREFIX_ROOT" -maxdepth 1 -mindepth 1 -type d 2>/dev/null | LC_ALL=C sort)
  fi
  if [ "$INCLUDE_LAUNCHERS" = "1" ] && [ -d "$CONTINUITY_LAUNCHER_DIR" ]; then
    while IFS= read -r f; do
      [ -n "$f" ] || continue
      LAUNCHER_RELS+=("${f#"$CONTINUITY_LAUNCHER_DIR"/}")
    done < <(find "$CONTINUITY_LAUNCHER_DIR" -type f -name '*.desktop' 2>/dev/null | LC_ALL=C sort)
    if [ -d "$CONTINUITY_STATE_DIR/icons" ]; then
      ICON_DIR="$CONTINUITY_STATE_DIR/icons"
    fi
  fi
  if [ "$INCLUDE_PREFS" = "1" ]; then
    while IFS='|' read -r entry dest; do
      [ -n "$entry" ] || continue
      src="$dest"
      [ -f "$src" ] || continue
      PREF_DEST+=("$entry")
      PREF_SRC+=("$src")
    done < <(pref_entries)
  fi
}

# ---------------------------------------------------------------------------
# export
# ---------------------------------------------------------------------------
cmd_export() {
  local OUT="" OUT_GIVEN=0
  INCLUDE_PREFIXES=1
  INCLUDE_LAUNCHERS=1
  INCLUDE_PREFS=1
  local DRY=0 YES=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --out|-o)         [ -n "${2:-}" ] || continuity_die "--out needs a path"; OUT="$2"; OUT_GIVEN=1; shift 2 ;;
      --no-prefixes)    INCLUDE_PREFIXES=0; shift ;;
      --no-launchers)   INCLUDE_LAUNCHERS=0; shift ;;
      --no-preferences) INCLUDE_PREFS=0; shift ;;
      --dry-run)        DRY=1; shift ;;
      --yes|-y)         YES=1; shift ;;
      -h|--help)        usage; exit 0 ;;
      *)                usage >&2; exit 2 ;;
    esac
  done

  continuity_load_env
  continuity_ensure_dirs
  setup_inventory

  if [ "${#PREFIX_DIRS[@]}" -eq 0 ] && [ "${#LAUNCHER_RELS[@]}" -eq 0 ] \
     && [ "${#PREF_SRC[@]}" -eq 0 ] && [ -z "$ICON_DIR" ]; then
    continuity_warn "there is nothing to export yet — no Windows apps, no launchers, no wizard state"
    printf 'Install a Windows app first (double-click any .exe), then export.\n'
    return 0
  fi

  # --- destination ----------------------------------------------------------
  if [ "$OUT_GIVEN" = "1" ] && [ -d "$OUT" ]; then
    OUT="$OUT/$(default_archive_name)"
  elif [ -z "$OUT" ]; then
    OUT="$HOME/$(default_archive_name)"
  fi
  local compression="gzip"
  case "${OUT##*.}" in
    zst|zstd) compression="zstd" ;;
    gz|tgz)   compression="gzip" ;;
  esac
  if [ "$compression" = "zstd" ] && ! continuity_have zstd; then
    continuity_warn "zstd is not installed — writing a gzip archive instead"
    compression="gzip"
  fi

  # --- the plan -------------------------------------------------------------
  local total_kb=0 kb slug
  printf 'ContinuityOS setup export%s\n' "$([ "$DRY" = "1" ] && printf ' (dry run — nothing is written)')"
  printf '  archive:   %s  [%s]\n' "$OUT" "$compression"
  for slug in ${PREFIX_DIRS[@]+"${PREFIX_DIRS[@]}"}; do
    kb="$(path_kb "$slug")"
    total_kb=$((total_kb + kb))
    printf '  prefix:    %-28s %8s  %s entries\n' "$(basename -- "$slug")" "$(fmt_kb "$kb")" "$(entry_count "$slug")"
  done
  if [ "${#LAUNCHER_RELS[@]}" -gt 0 ]; then
    printf '  launchers: %d file(s)\n' "${#LAUNCHER_RELS[@]}"
  fi
  if [ -n "$ICON_DIR" ]; then
    kb="$(path_kb "$ICON_DIR")"
    total_kb=$((total_kb + kb))
    printf '  icons:     %s\n' "$(fmt_kb "$kb")"
  fi
  local i=0
  while [ "$i" -lt "${#PREF_SRC[@]}" ]; do
    printf '  pref:      %s\n' "${PREF_DEST[$i]}"
    i=$((i + 1))
  done
  printf '  size:      about %s of payload to compress (compressed size is only known after writing)\n' \
    "$(fmt_kb "$total_kb")"

  if [ "$DRY" = "1" ]; then
    printf '\nNot in the archive: Steam, Valve Proton installations and game libraries.\n'
    return 0
  fi

  if [ -e "$OUT" ] && [ "$YES" != "1" ]; then
    continuity_die "'$OUT' already exists — move it, or re-run with --yes to overwrite it"
  fi
  mkdir -p "$(dirname -- "$OUT")" || continuity_die "cannot create $(dirname -- "$OUT")"

  # --- stage ----------------------------------------------------------------
  # Checksums are taken from the staged files and tar reads them a moment later.
  # A prefix that is still in use can change in between, which would produce an
  # archive that fails its own integrity check on the machine receiving it — so
  # say so before it happens rather than after.
  if continuity_have pgrep && pgrep -f -- "$CONTINUITY_PREFIX_ROOT" >/dev/null 2>&1; then
    continuity_warn "a Windows app is running from these prefixes — close it first, or the archive may fail its own checksum check"
  fi
  WORK="$(work_dir)"
  # Two statements, not one `local`: bash expands every argument of a single
  # local/declare before performing any of its assignments, so PAYLOAD="$SETUP/…"
  # on the same line reads SETUP as unbound under `set -u`.
  local SETUP PAYLOAD
  SETUP="$WORK/stage/continuity-setup"
  PAYLOAD="$SETUP/payload"
  mkdir -p "$PAYLOAD/prefix-root" "$PAYLOAD/launchers" "$PAYLOAD/state" "$PAYLOAD/config"

  for slug in ${PREFIX_DIRS[@]+"${PREFIX_DIRS[@]}"}; do
    copy_tree "$slug" "$PAYLOAD/prefix-root" || continuity_die "cannot stage prefix $(basename -- "$slug")"
  done
  local rel
  for rel in ${LAUNCHER_RELS[@]+"${LAUNCHER_RELS[@]}"}; do
    copy_file "$CONTINUITY_LAUNCHER_DIR/$rel" "$PAYLOAD/launchers/$rel" || \
      continuity_warn "could not stage launcher $rel"
  done
  if [ -n "$ICON_DIR" ]; then
    copy_tree "$ICON_DIR" "$PAYLOAD/state" || continuity_warn "could not stage icons"
  fi
  i=0
  while [ "$i" -lt "${#PREF_SRC[@]}" ]; do
    copy_file "${PREF_SRC[$i]}" "$PAYLOAD/${PREF_DEST[$i]}" || \
      continuity_warn "could not stage ${PREF_DEST[$i]}"
    i=$((i + 1))
  done

  {
    printf 'SETUP_FORMAT=1\n'
    printf 'CREATED=%s\n' "$(date -Is)"
    printf 'HOSTNAME=%s\n' "$(uname -n 2>/dev/null || printf unknown)"
    printf 'USER=%s\n' "$(id -un)"
    printf 'HOME=%s\n' "$HOME"
    printf 'DISTRO_VERSION=%s\n' "${CONTINUITY_VERSION:-unknown}"
    printf 'PREFIX_COUNT=%d\n' "${#PREFIX_DIRS[@]}"
    printf 'LAUNCHER_COUNT=%d\n' "${#LAUNCHER_RELS[@]}"
    printf 'PAYLOAD_KB=%s\n' "$(path_kb "$PAYLOAD")"
  } >"$SETUP/manifest.conf"

  # Bulk hashing, not one process per file: a prefix holds tens of thousands.
  if continuity_have sha256sum; then
    ( cd "$PAYLOAD" && find . -type f -exec sha256sum {} + | LC_ALL=C sort ) >"$SETUP/checksums.sha256"
  elif continuity_have shasum; then
    ( cd "$PAYLOAD" && find . -type f -exec shasum -a 256 {} + | LC_ALL=C sort ) >"$SETUP/checksums.sha256"
  else
    continuity_die "sha256sum is required to write a verifiable archive (sudo pacman -S coreutils)"
  fi
  rm -f "$OUT"

  local level="${CONTINUITY_EXPORT_ZSTD_LEVEL:-10}"
  case "$level" in ''|*[!0-9]*) level=10 ;; esac
  continuity_info "compressing $(entry_count "$PAYLOAD") file(s) — this can take a few minutes"
  if [ "$compression" = "zstd" ]; then
    tar -C "$WORK/stage" -cf - continuity-setup | zstd "-${level}" -T0 -q -o "$OUT" || {
      rm -f "$OUT"
      continuity_die "writing the archive failed (out of space?) — nothing was left behind"
    }
    continuity_info "verifying the archive stream"
    zstd -t -q -- "$OUT" || { rm -f "$OUT"; continuity_die "the archive did not pass its own stream test"; }
  else
    tar -C "$WORK/stage" -czf "$OUT" continuity-setup || {
      rm -f "$OUT"
      continuity_die "writing the archive failed (out of space?) — nothing was left behind"
    }
    gzip -t -- "$OUT" 2>/dev/null || { rm -f "$OUT"; continuity_die "the archive did not pass its own stream test"; }
  fi

  continuity_refresh_desktop_db
  continuity_log "export: ${#PREFIX_DIRS[@]} prefix(es), ${#LAUNCHER_RELS[@]} launcher(s) -> $OUT"
  continuity_ok "setup exported to $OUT ($(human_size "$OUT"))"
  printf '\nInside: %d Windows app prefix(es), %d launcher(s), %d preference file(s)%s.\n' \
    "${#PREFIX_DIRS[@]}" "${#LAUNCHER_RELS[@]}" "${#PREF_SRC[@]}" \
    "$([ -n "$ICON_DIR" ] && printf ', plus launcher icons')"
  printf 'Not inside: Steam, Valve Proton installations and game libraries. On the other\n'
  printf 'machine, install Steam/Proton, import this archive, and register a library in place with\n'
  printf '  continuity-wizard import-steam\n'
}

# ---------------------------------------------------------------------------
# import
# ---------------------------------------------------------------------------
cmd_import() {
  local ARCHIVE="" MODE="merge" DRY=0 YES=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --replace) MODE="replace"; shift ;;
      --merge)   MODE="merge"; shift ;;
      --dry-run) DRY=1; shift ;;
      --yes|-y)  YES=1; shift ;;
      -h|--help) usage; exit 0 ;;
      -*)        usage >&2; exit 2 ;;
      *)         [ -n "$ARCHIVE" ] && { usage >&2; exit 2; }; ARCHIVE="$1"; shift ;;
    esac
  done
  [ -n "$ARCHIVE" ] || { usage >&2; exit 2; }
  [ -f "$ARCHIVE" ] || continuity_die "no such archive: $ARCHIVE"
  [ -r "$ARCHIVE" ] || continuity_die "cannot read $ARCHIVE"

  ARCHIVE="$(readlink -f -- "$ARCHIVE" 2>/dev/null || printf '%s' "$ARCHIVE")"
  continuity_load_env

  # --- manifest and format checks (cheap: two members, no payload) ----------
  WORK="$(work_dir)"
  local head_dir="$WORK/head"
  # The manifest is mandatory; the checksum list is requested separately so a
  # missing one is reported as exactly that, instead of as an unreadable archive.
  extract_members "$head_dir" "$ARCHIVE" continuity-setup/manifest.conf || \
    continuity_die "cannot read the archive — is it a ContinuityOS setup archive? (see: continuity-export inspect)"
  extract_members "$head_dir" "$ARCHIVE" continuity-setup/checksums.sha256 >/dev/null 2>&1 || true
  local MANIFEST="$head_dir/continuity-setup/manifest.conf"
  local CHECKSUMS="$head_dir/continuity-setup/checksums.sha256"
  [ -r "$MANIFEST" ] || continuity_die "the archive has no manifest.conf — this is not a ContinuityOS setup archive"
  local FMT
  FMT="$(manifest_get "$MANIFEST" SETUP_FORMAT)"
  case "$FMT" in
    ''|*[!0-9]*) continuity_die "the archive does not declare a SETUP_FORMAT — this is not a ContinuityOS setup archive" ;;
  esac
  [ "$FMT" -le 1 ] || continuity_die "the archive was written by a newer ContinuityOS (SETUP_FORMAT=$FMT); this machine understands 1"
  [ "$FMT" -ge 1 ] || continuity_die "unusable SETUP_FORMAT=$FMT"

  local OLD_HOME OLD_USER SRC_HOST CREATED P_PREFIX P_LAUNCH P_KB
  OLD_HOME="$(manifest_get "$MANIFEST" HOME)"
  OLD_USER="$(manifest_get "$MANIFEST" USER)"
  SRC_HOST="$(manifest_get "$MANIFEST" HOSTNAME)"
  CREATED="$(manifest_get "$MANIFEST" CREATED)"
  P_PREFIX="$(manifest_get "$MANIFEST" PREFIX_COUNT)"
  P_LAUNCH="$(manifest_get "$MANIFEST" LAUNCHER_COUNT)"
  P_KB="$(manifest_get "$MANIFEST" PAYLOAD_KB)"
  case "$P_PREFIX" in ''|*[!0-9]*) P_PREFIX=0 ;; esac
  case "$P_LAUNCH" in ''|*[!0-9]*) P_LAUNCH=0 ;; esac
  case "$P_KB" in ''|*[!0-9]*) P_KB=0 ;; esac

  printf 'ContinuityOS setup archive\n'
  printf '  written:   %s on %s by %s\n' "$CREATED" "${SRC_HOST:-unknown}" "${OLD_USER:-unknown}"
  printf '  contents:  %d prefix(es), %d launcher(s), %d checksum line(s)\n' \
    "$P_PREFIX" "$P_LAUNCH" "$(checksums_line_count "$CHECKSUMS")"
  printf '  paths:     %s -> %s%s\n' "${OLD_HOME:-unknown}" "$HOME" \
    "$([ -n "$OLD_HOME" ] && [ "$OLD_HOME" != "$HOME" ] && printf '  (launcher paths are rewritten)')"

  if [ "$P_KB" -gt 0 ]; then
    local avail
    avail="$(free_kb "$CONTINUITY_PREFIX_ROOT" 2>/dev/null || true)"
    case "$avail" in
      ''|*[!0-9]*) ;;
      *)
        if [ "$avail" -lt "$P_KB" ]; then
          continuity_warn "only $(fmt_kb "$avail") free where the prefixes live, but the archive holds $(fmt_kb "$P_KB")"
        fi
        ;;
    esac
  fi

  # --- plan -----------------------------------------------------------------
  local extract payload
  extract="$WORK/full"
  payload="$extract/continuity-setup/payload"
  local slug rel target action
  if [ "$DRY" = "1" ]; then
    printf '\nPlan (%s mode, nothing is written):\n' "$MODE"
    # Count from the manifest, but list real member names, so the plan cannot
    # disagree with what import would actually do.
    list_prefix_members "$ARCHIVE" "$P_PREFIX" "$P_LAUNCH"
    printf '\nRun the same command without --dry-run to apply it.\n'
    return 0
  fi

  # --- verify before touching anything -------------------------------------
  if [ "$P_KB" -gt 0 ]; then
    continuity_info "verifying $(fmt_kb "$P_KB") of payload checksums"
  else
    continuity_info "verifying the payload checksums"
  fi
  extract_archive_to "$extract" "$ARCHIVE" || continuity_die "extracting the archive failed"
  [ -d "$payload" ] || continuity_die "the archive has no payload directory — refusing"
  verify_checksums "$payload" "$extract/continuity-setup/checksums.sha256" || \
    continuity_die "nothing was imported: the archive is corrupt or incomplete"

  continuity_ensure_dirs
  local IMPORTED=0 SKIPPED=0 REPLACED=0 LAUNCHED=0
  local -a NOTES=()

  # --- prefixes -------------------------------------------------------------
  while IFS= read -r slug; do
    [ -n "$slug" ] || continue
    target="$CONTINUITY_PREFIX_ROOT/$slug"
    if [ -e "$target" ] && [ "$MODE" = "merge" ]; then
      SKIPPED=$((SKIPPED + 1))
      NOTES+=("kept the existing prefix '$slug' (use --replace to restore the archived copy)")
      continue
    fi
    if [ -e "$target" ]; then
      action="$(move_aside "$target" "$slug")" || continuity_die "cannot move the existing prefix '$slug' aside"
      REPLACED=$((REPLACED + 1))
      NOTES+=("previous '$slug' kept at $action")
    fi
    cp -a -- "$payload/prefix-root/$slug" "$CONTINUITY_PREFIX_ROOT/$slug" || \
      continuity_die "copying prefix '$slug' failed (out of space?)"
    chmod 700 "$CONTINUITY_PREFIX_ROOT/$slug" 2>/dev/null || true
    IMPORTED=$((IMPORTED + 1))
    printf '  prefix:    %s\n' "$slug"
  done < <(find "$payload/prefix-root" -maxdepth 1 -mindepth 1 -type d -printf '%f\n' 2>/dev/null | LC_ALL=C sort)

  # --- launcher icons (before the launchers, so Icon= is never dangling) ----
  if [ -d "$payload/state/icons" ]; then
    local icon_slug icon_dst
    while IFS= read -r icon_slug; do
      [ -n "$icon_slug" ] || continue
      icon_dst="$CONTINUITY_STATE_DIR/icons/$icon_slug"
      if [ -e "$icon_dst" ] && [ "$MODE" = "merge" ]; then
        cp -a -n -- "$payload/state/icons/$icon_slug/." "$icon_dst/" 2>/dev/null || true
        continue
      fi
      if [ -e "$icon_dst" ]; then
        move_aside "$icon_dst" "icons-$icon_slug" >/dev/null || true
      fi
      mkdir -p "$CONTINUITY_STATE_DIR/icons"
      cp -a -- "$payload/state/icons/$icon_slug" "$CONTINUITY_STATE_DIR/icons/" 2>/dev/null || \
        continuity_warn "could not restore icons for '$icon_slug'"
    done < <(find "$payload/state/icons" -maxdepth 1 -mindepth 1 -type d -printf '%f\n' 2>/dev/null | LC_ALL=C sort)
  fi

  # --- launchers ------------------------------------------------------------
  if [ -d "$payload/launchers" ]; then
    while IFS= read -r rel; do
      [ -n "$rel" ] || continue
      target="$CONTINUITY_LAUNCHER_DIR/$rel"
      if [ -e "$target" ] && [ "$MODE" = "merge" ]; then
        SKIPPED=$((SKIPPED + 1))
        continue
      fi
      if [ -e "$target" ]; then
        move_aside "$target" "launcher-$rel" >/dev/null || true
        REPLACED=$((REPLACED + 1))
      fi
      mkdir -p "$(dirname -- "$target")" || continue
      cp -a -- "$payload/launchers/$rel" "$target" || { continuity_warn "could not restore launcher $rel"; continue; }
      rewrite_desktop_paths "$target" "$OLD_HOME" "$HOME"
      chmod 0644 "$target" 2>/dev/null || true
      LAUNCHED=$((LAUNCHED + 1))
    done < <(find "$payload/launchers" -type f -name '*.desktop' -printf '%P\n' 2>/dev/null | LC_ALL=C sort)
  fi

  # --- preferences ----------------------------------------------------------
  local key value merged
  if [ -f "$payload/config/environment.conf" ]; then
    if [ "$MODE" = "replace" ] && [ -e "$CONTINUITY_CONFIG_DIR/environment.conf" ]; then
      move_aside "$CONTINUITY_CONFIG_DIR/environment.conf" "environment.conf" >/dev/null || true
    fi
    merged="$(merge_conf_file "$payload/config/environment.conf" "$CONTINUITY_CONFIG_DIR/environment.conf")"
    if [ -n "$merged" ]; then
      printf '  prefs:     merged into %s\n' "$CONTINUITY_CONFIG_DIR/environment.conf"
      awk '{ print "               " $0 }' <<<"$merged"
      NOTES+=("engine preferences were merged key by key, so local-only keys survived")
    fi
  fi
  if [ -f "$payload/config/region.conf" ]; then
    merged="$(merge_conf_file "$payload/config/region.conf" "$CONTINUITY_CONFIG_DIR/region.conf")"
    if [ -n "$merged" ]; then
      printf '  region:    merged into %s\n' "$CONTINUITY_CONFIG_DIR/region.conf"
      awk '{ print "               " $0 }' <<<"$merged"
      NOTES+=("locale/keyboard/timezone came across too — check they suit this machine")
    fi
  fi

  local pair entry src_where dst_where
  while IFS='|' read -r entry dst_where; do
    case "$entry" in state/*) ;; *) continue ;; esac
    src_where="$payload/$entry"
    [ -f "$src_where" ] || continue
    if [ -e "$dst_where" ] && [ "$MODE" = "merge" ]; then
      NOTES+=("kept the existing $(basename -- "$dst_where")")
      continue
    fi
    if [ -e "$dst_where" ]; then
      move_aside "$dst_where" "$(basename -- "$dst_where")" >/dev/null || true
    fi
    mkdir -p "$(dirname -- "$dst_where")" || continue
    cp -a -- "$src_where" "$dst_where" || { continuity_warn "could not restore $entry"; continue; }
    case "$(basename -- "$dst_where")" in
      wizard.state) chmod 0600 "$dst_where" 2>/dev/null || true ;;
      *)            chmod 0644 "$dst_where" 2>/dev/null || true ;;
    esac
    NOTES+=("restored $(basename -- "$dst_where")")
  done < <(pref_entries)

  [ "$LAUNCHED" -gt 0 ] && continuity_refresh_desktop_db

  # --- summary --------------------------------------------------------------
  local note
  for note in ${NOTES[@]+"${NOTES[@]}"}; do
    continuity_info "$note"
  done
  continuity_log "import: $ARCHIVE — $IMPORTED prefix(es) restored, $REPLACED replaced, $SKIPPED skipped, $LAUNCHED launcher(s)"
  continuity_ok "setup imported: $IMPORTED prefix(es), $LAUNCHED launcher(s) restored, $SKIPPED item(s) left alone"

  if [ "$LAUNCHED" -eq 0 ] && [ "$IMPORTED" -eq 0 ]; then
    printf '\nNothing changed here — everything in the archive already exists.\n'
    printf 'Re-run with --replace to restore the archived copies over the local ones.\n'
    return 0
  fi

  printf '\nWhat works now\n'
  printf '  * your Windows programs are in the app drawer; launch one and it opens the\n'
  printf '    restored prefix from %s\n' "$CONTINUITY_PREFIX_ROOT"
  printf '  * prefixes are isolated: removing one is still a folder delete\n'
  printf '    (continuity-prefix rm <slug>)\n'
  printf 'What still needs doing here\n'
  printf '  * Steam and the game libraries did not move. Install Steam, then register an\n'
  printf '    existing library in place:  continuity-wizard import-steam\n'
  printf '  * Steam/Valve Proton must be installed for Windows apps; launch Steam once to download Proton\n'
  printf '  * if a launcher icon looks blank, run:  continuity-prefix launchers <slug> --auto\n'
}

# Used only by the import dry run: name the members that will be placed, straight
# from the archive, so the plan cannot drift from what import does.
list_prefix_members() {
  local archive="$1" want_prefix="$2" want_launcher="$3" kind
  kind="$(archive_compression "$archive")"
  printf '  %s prefix(es) and %s launcher(s) will be placed:\n' "$want_prefix" "$want_launcher"
  list_members() {
    case "$kind" in
      zstd) zstd -dc -- "$archive" | tar -tf - 2>/dev/null ;;
      gzip) tar -tzf "$archive" 2>/dev/null ;;
      *)    tar -tf "$archive" 2>/dev/null ;;
    esac
  }
  local member base
  { list_members || true; } | awk '
    /^continuity-setup\/payload\/prefix-root\/[^/]+\/$/ { sub(/.*prefix-root\//, ""); sub(/\/$/, ""); print "    prefix:    " $0; next }
    /^continuity-setup\/payload\/launchers\/.*\.desktop$/ { sub(/.*launchers\//, ""); print "    launcher:  " $0 }
  ' | LC_ALL=C sort -u | awk 'NR <= 40 { print } END { if (NR > 40) print "    … and " (NR - 40) " more" }'
}

# ---------------------------------------------------------------------------
# inspect / list
# ---------------------------------------------------------------------------
cmd_inspect() {
  local ARCHIVE="${1:-}"
  [ -n "$ARCHIVE" ] || { usage >&2; exit 2; }
  [ -f "$ARCHIVE" ] || continuity_die "no such archive: $ARCHIVE"
  continuity_load_env
  WORK="$(work_dir)"
  local head_dir="$WORK/head"
  # stderr is deliberately NOT discarded: "required command 'zstd' not found" is
  # the one message that explains this failure, and swallowing it looked like a
  # silent crash.
  extract_members "$head_dir" "$ARCHIVE" continuity-setup/manifest.conf >/dev/null || \
    continuity_die "cannot read the archive — is it a ContinuityOS setup archive?"
  extract_members "$head_dir" "$ARCHIVE" continuity-setup/checksums.sha256 >/dev/null 2>&1 || true
  local MANIFEST="$head_dir/continuity-setup/manifest.conf"
  [ -r "$MANIFEST" ] || continuity_die "the archive has no manifest.conf — this is not a ContinuityOS setup archive"
  local FMT
  FMT="$(manifest_get "$MANIFEST" SETUP_FORMAT)"
  case "$FMT" in ''|*[!0-9]*) continuity_die "the archive does not declare a SETUP_FORMAT" ;; esac
  printf 'Archive:   %s\n' "$(readlink -f -- "$ARCHIVE" 2>/dev/null || printf '%s' "$ARCHIVE")"
  printf 'Size:      %s [%s]\n' "$(human_size "$ARCHIVE")" "$(archive_compression "$ARCHIVE")"
  printf 'Format:    SETUP_FORMAT=%s%s\n' "$FMT" "$([ "$FMT" -le 1 ] && printf '' || printf '  (NEWER than this machine understands)')"
  printf '\nmanifest.conf\n'
  awk '{ print "  " $0 }' "$MANIFEST"
  local lines
  lines="$(checksums_line_count "$head_dir/continuity-setup/checksums.sha256")"
  printf '\nchecksums: %s file(s) recorded\n' "$lines"
  printf 'Verify them (and see the plan) with:  continuity-export import %s --dry-run\n' "$ARCHIVE"
}

cmd_list() {
  continuity_load_env
  local slug count launchers total_kb=0 kb
  printf 'ContinuityOS setup on %s\n' "$(uname -n 2>/dev/null || printf this machine)"
  printf '\nWindows app prefixes (%s)\n' "$CONTINUITY_PREFIX_ROOT"
  count=0
  while IFS= read -r slug; do
    [ -n "$slug" ] || continue
    count=$((count + 1))
    launchers="$(find "$CONTINUITY_LAUNCHER_DIR/$slug" -maxdepth 1 -type f -name '*.desktop' 2>/dev/null | awk 'END { print NR + 0 }' || true)"
    kb="$(path_kb "$CONTINUITY_PREFIX_ROOT/$slug")"
    total_kb=$((total_kb + kb))
    printf '  %-28s %8s  %s launcher(s)\n' "$slug" "$(fmt_kb "$kb")" "$launchers"
  done < <(find "$CONTINUITY_PREFIX_ROOT" -maxdepth 1 -mindepth 1 -type d -printf '%f\n' 2>/dev/null | LC_ALL=C sort)
  [ "$count" -eq 0 ] && printf '  (none yet)\n'
  printf '  total: %s\n' "$(fmt_kb "$total_kb")"

  printf '\nLaunchers\n'
  local all_launchers
  all_launchers="$(find "$CONTINUITY_LAUNCHER_DIR" -type f -name '*.desktop' 2>/dev/null | awk 'END { print NR + 0 }' || true)"
  printf '  %s file(s) in %s\n' "${all_launchers:-0}" "$CONTINUITY_LAUNCHER_DIR"

  printf '\nFirst-run wizard\n'
  if [ -e "$CONTINUITY_STATE_DIR/wizard.done" ]; then
    printf '  completed %s\n' "$(cat "$CONTINUITY_STATE_DIR/wizard.done" 2>/dev/null || printf 'yes')"
  else
    printf '  not completed yet (it will open at the next login)\n'
  fi

  printf '\nPreferences\n'
  local f
  for f in "$CONTINUITY_CONFIG_DIR/environment.conf" "$CONTINUITY_CONFIG_DIR/region.conf"; do
    if [ -r "$f" ]; then printf '  present  %s\n' "$f"; else printf '  missing  %s\n' "$f"; fi
  done
  if [ -e "$CONTINUITY_STATE_DIR/gaming-mode.enabled" ]; then
    printf '  present  %s\n' "$CONTINUITY_STATE_DIR/gaming-mode.enabled"
  fi
  printf '\nExport this setup with:  continuity-export export\n'
}

# ---------------------------------------------------------------------------
# dispatch
# ---------------------------------------------------------------------------
case "$ACTION" in
  export)  cmd_export "$@" ;;
  import)  cmd_import "$@" ;;
  inspect) cmd_inspect "$@" ;;
  list|ls) cmd_list ;;
  ""|-h|--help|help) usage ;;
  *) usage >&2; exit 2 ;;
esac
