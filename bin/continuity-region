#!/usr/bin/env bash
# ContinuityOS — locale, keyboard layout, timezone and Wi-Fi for a new machine.
#
# The first-run wizard's "region" step, usable on its own. It covers the boring
# part of installing an OS that is easy to get wrong: a keyboard layout you can
# actually type with, a clock in the right zone, and a network.
#
#   continuity-region show                  current values, and where each comes from
#   continuity-region autodetect [--apply]  guess from what the machine already says
#   continuity-region locale en_GB.UTF-8
#   continuity-region keymap gb
#   continuity-region timezone Europe/London
#   continuity-region wifi scan
#   continuity-region wifi connect "My Network"     # passphrase on stdin
#
# USER SCOPE IS THE DEFAULT, and that is deliberate. This runs inside a
# first-login wizard, so it touches only files the logged-in user owns:
#   ~/.config/hypr/local.conf                    the keyboard layout
#   ~/.config/continuity/region.conf             LANG/LC_TIME/TZ, sourced by continuity-shell
#   ~/.config/environment.d/10-continuity-region.conf   the same, for systemd --user
# Nothing here needs root, nothing here can leave a machine unable to reach a
# login prompt, and there is no half-applied system state to recover from.
# --system additionally drives localectl/timedatectl; the wizard never passes it.
#
# The Wi-Fi passphrase is read from STDIN, never from argv: argv is world-readable
# in /proc/<pid>/cmdline, so a passphrase there is visible to every local user for
# as long as the command runs. It is also never echoed, never logged, and its
# temporary passwd-file is removed by a trap even when nmcli fails.
set -euo pipefail

_lib="${CONTINUITY_LIB:-}"
if [ -z "$_lib" ]; then
  for _p in \
    "$(cd "$(dirname "$0")" 2>/dev/null && pwd)/continuity-common.sh" \
    "$(cd "$(dirname "$0")/.." 2>/dev/null && pwd)/lib/continuity-common.sh" \
    /usr/local/lib/continuity/continuity-common.sh \
    /usr/lib/continuity/continuity-common.sh; do
    [ -r "$_p" ] && { _lib="$_p"; break; }
  done
fi
[ -r "${_lib:-}" ] || { echo "continuity-region: cannot locate continuity-common.sh" >&2; exit 1; }
# shellcheck source=../lib/continuity-common.sh
. "$_lib"

PROG="${0##*/}"
continuity_load_env

DRY=0
SYSTEM=0
JSON=0
APPLY=0
ACTION=""
ARGS=()

HYPR_LOCAL="$HOME/.config/hypr/local.conf"
REGION_CONF="$CONTINUITY_CONFIG_DIR/region.conf"
ENVD_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/environment.d"
MARK_BEGIN="# >>> continuity-region keyboard"
MARK_END="# <<< continuity-region keyboard"

usage() {
  cat <<'EOF'
continuity-region — locale, keyboard, timezone and Wi-Fi

USAGE
  continuity-region show [--json]
  continuity-region autodetect [--apply]
  continuity-region list-locales | list-keymaps | list-timezones
  continuity-region locale LANG [--system]
  continuity-region keymap LAYOUT [VARIANT] [--system]
  continuity-region timezone AREA/CITY [--system]
  continuity-region wifi status | scan
  continuity-region wifi connect SSID
  continuity-region --dry-run <command> [args] | --help

OPTIONS
  --dry-run        Print what would change, write nothing, run no sudo.
  --system         Also apply the change system-wide through localectl/timedatectl.
  --json           Machine-readable output (show, wifi status).
  --apply          autodetect only: write the values it found.

WHAT IT WRITES (user scope, always)
  ~/.config/hypr/local.conf
      a fenced "input { kb_layout = … }" block. local.conf is sourced last by
      hyprland.conf, so it wins over conf.d/input.conf without editing a file
      that gets overwritten on the next update.
  ~/.config/continuity/region.conf
      LANG/LC_TIME/TZ as a plain shell fragment, sourced by continuity-shell.
  ~/.config/environment.d/10-continuity-region.conf
      the same variables, so systemd --user services (umu seed, portals) agree
      with the graphical session instead of logging in a different language.

WIFI
  The passphrase for `wifi connect` is read from stdin. Use a pipe, or run it
  from a terminal and it will not be echoed:
      printf '%s\n' "$pass" | continuity-region wifi connect "My Network"

ENVIRONMENT (for tests and unusual systems)
  CONTINUITY_REGION_NMCLI / _LOCALECTL / _TIMEDATECTL / _HYPRCTL
      override the binary each feature uses; an empty value means "not installed".
EOF
}

# ---------------------------------------------------------------------------
# argument parsing
# ---------------------------------------------------------------------------
# Flags are accepted before or after the subcommand, because both
# `continuity-region --dry-run locale x` and `... locale x --dry-run` are natural.
while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run|-n) DRY=1; shift ;;
    --system)     SYSTEM=1; shift ;;
    --json)       JSON=1; shift ;;
    --apply)      APPLY=1; shift ;;
    -h|--help|help) usage; exit 0 ;;
    --) shift; while [ $# -gt 0 ]; do ARGS+=("$1"); shift; done ;;
    -*) printf '%s: unknown option %s\n' "$PROG" "$1" >&2; usage >&2; exit 2 ;;
    *) if [ -z "$ACTION" ]; then ACTION="$1"; else ARGS+=("$1"); fi; shift ;;
  esac
done
# Subcommand arguments become the positional parameters (the ${arr[@]+…} form is
# the only one that is safe under `set -u` with an empty array).
set -- ${ARGS[@]+"${ARGS[@]}"}

# ---------------------------------------------------------------------------
# small helpers
# ---------------------------------------------------------------------------
# An overridable binary lookup: an override that is missing means "not installed"
# rather than "wrong path", which keeps the fallbacks honest on a test machine.
tool_path() {
  local override="$1" default="$2"
  if [ -n "$override" ]; then
    if command -v "$override" >/dev/null 2>&1; then printf '%s' "$override"; return 0; fi
    [ -x "$override" ] && { printf '%s' "$override"; return 0; }
    return 1
  fi
  command -v "$default" >/dev/null 2>&1 && printf '%s' "$default"
}

nmcli_bin()      { tool_path "${CONTINUITY_REGION_NMCLI:-}" nmcli; }
localectl_bin()  { tool_path "${CONTINUITY_REGION_LOCALECTL:-}" localectl; }
timedatectl_bin(){ tool_path "${CONTINUITY_REGION_TIMEDATECTL:-}" timedatectl; }
hyprctl_bin()    { tool_path "${CONTINUITY_REGION_HYPRCTL:-}" hyprctl; }

is_root() { [ "$(id -u 2>/dev/null || echo 1)" = "0" ]; }

# System-scope actions go through here so --dry-run can never escalate.
run_sudo() {
  if [ "$DRY" = "1" ]; then printf 'would: sudo %s\n' "$*"; return 0; fi
  if is_root; then "$@"; return 0; fi
  continuity_have sudo || continuity_die "changing system settings needs root: sudo $*"
  sudo "$@"
}

json_str() { local s="$1"; s="${s//\\/\\\\}"; s="${s//\"/\\\"}"; printf '"%s"' "$s"; }

# Read a KEY= line out of a file without needing the file to be sourceable.
file_get() {
  local file="$1" key="$2"
  [ -r "$file" ] || return 0
  awk -F= -v k="$key" '$1==k { sub(/^[^=]*=/, ""); print; exit }' "$file" 2>/dev/null || true
}

# Set/append KEY=VALUE in a file, preserving every unrelated line. Matching on the
# whole "KEY=" prefix (not on a split field) keeps values that contain '=' intact.
file_set() {
  local file="$1" key="$2" value="$3" tmp
  mkdir -p "$(dirname "$file")"
  tmp="$(mktemp)" || continuity_die "cannot create a temporary file"
  if [ -e "$file" ]; then
    awk -v k="$key" -v v="$value" '
      index($0, k "=") == 1 { print k "=" v; found = 1; next }
      { print }
      END { if (!found) print k "=" v }
    ' "$file" >"$tmp" || { rm -f "$tmp"; continuity_die "could not read $file"; }
  else
    printf '%s=%s\n' "$key" "$value" >"$tmp"
  fi
  mv "$tmp" "$file"
  chmod 0644 "$file" 2>/dev/null || true
}

# ---------------------------------------------------------------------------
# where the values come from
# ---------------------------------------------------------------------------
local_conf_keymap() {
  [ -r "$HYPR_LOCAL" ] || return 0
  awk -v b="$MARK_BEGIN" -v e="$MARK_END" '
    $0 == b { inblock = 1; next }
    $0 == e { inblock = 0 }
    inblock && $1 == "kb_layout" { sub(/^[^=]*=[[:space:]]*/, ""); gsub(/[[:space:]]+$/, ""); print; found = 1 }
    inblock && $1 == "kb_variant" { i = index($0, "="); v = substr($0, i + 1); gsub(/^[[:space:]]+|[[:space:]]+$/, "", v); print "VARIANT=" v }
    END { if (!found) exit 0 }
  ' "$HYPR_LOCAL" 2>/dev/null || true
}

local_conf_layout() {
  local v
  v="$(local_conf_keymap | sed -n 's/^VARIANT=//p' | sed -n '1p')"
  printf '%s' "$v"
}

# What Hyprland is running right now — the truth when a session is up.
hypr_live() {
  local c out
  c="$(hyprctl_bin)" || return 0
  [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] || return 0
  out="$("$c" getoption input:kb_layout 2>/dev/null | sed -n 's/^[[:space:]]*str:[[:space:]]*//p' | sed -n '1p')" || true
  printf '%s' "$out"
}

localectl_system_locale() {
  local c out
  c="$(localectl_bin)" || return 0
  out="$("$c" status 2>/dev/null | sed -n 's/^[[:space:]]*System Locale:[[:space:]]*LANG=\([^ ]*\).*/\1/p' | sed -n '1p')" || true
  if [ -z "$out" ] && [ -r /etc/locale.conf ]; then
    out="$(file_get /etc/locale.conf LANG)"
  fi
  printf '%s' "$out"
}

system_keymap() {
  local c out
  c="$(localectl_bin)" || return 0
  out="$("$c" status 2>/dev/null | sed -n 's/^[[:space:]]*X11 Layout:[[:space:]]*//p' | sed -n '1p')" || true
  [ -n "$out" ] || out="$("$c" status 2>/dev/null | sed -n 's/^[[:space:]]*VC Keymap:[[:space:]]*//p' | sed -n '1p')"
  if [ -z "$out" ] && [ -r /etc/vconsole.conf ]; then
    out="$(file_get /etc/vconsole.conf KEYMAP)"
  fi
  printf '%s' "$out"
}

system_timezone() {
  local tz=""
  if [ -L /etc/localtime ]; then
    tz="$(readlink /etc/localtime 2>/dev/null || true)"
    case "$tz" in */zoneinfo/*) tz="${tz##*/zoneinfo/}" ;; *) tz="" ;; esac
  fi
  if [ -z "$tz" ] && [ -r /etc/timezone ]; then
    tz="$(sed -n '1p' /etc/timezone 2>/dev/null || true)"
  fi
  printf '%s' "$tz"
}

# --- the eight values show/wifi status report ---------------------------------
# Each prints "value<TAB>source"; an unknown value is an empty value with the
# source `unset`, so callers can always split on exactly one tab.
locale_value() {
  local v
  v="$(file_get "$REGION_CONF" LANG)"
  [ -n "$v" ] && { printf '%s\t%s\n' "$v" region.conf; return 0; }
  v="$(localectl_system_locale)"
  [ -n "$v" ] && { printf '%s\t%s\n' "$v" /etc/locale.conf; return 0; }
  v="${LANG:-}"
  [ -n "$v" ] && { printf '%s\t%s\n' "$v" environment; return 0; }
  printf '\t%s\n' unset
}

lc_time_value() {
  local v
  v="$(file_get "$REGION_CONF" LC_TIME)"
  [ -n "$v" ] && { printf '%s\t%s\n' "$v" region.conf; return 0; }
  printf '\t%s\n' unset
}

keymap_value() {
  local v
  v="$(local_conf_keymap | sed -n '/^VARIANT=/!p' | sed -n '1p')"
  [ -n "$v" ] && { printf '%s\t%s\n' "$v" hyprland-local.conf; return 0; }
  v="$(hypr_live)"
  [ -n "$v" ] && { printf '%s\t%s\n' "$v" hyprland-live; return 0; }
  v="$(system_keymap)"
  [ -n "$v" ] && { printf '%s\t%s\n' "$v" system; return 0; }
  printf '\t%s\n' unset
}

variant_value() {
  local v
  v="$(local_conf_layout)"
  [ -n "$v" ] && { printf '%s\t%s\n' "$v" hyprland-local.conf; return 0; }
  printf '\t%s\n' unset
}

timezone_value() {
  local v
  v="$(file_get "$REGION_CONF" TZ)"
  [ -n "$v" ] && { printf '%s\t%s\n' "$v" region.conf; return 0; }
  v="$(system_timezone)"
  [ -n "$v" ] && { printf '%s\t%s\n' "$v" /etc/localtime; return 0; }
  printf '\t%s\n' unset
}

# State is one of connected|disconnected|unavailable. A machine with no Wi-Fi
# hardware reports `unavailable` too — from the user's side that is the same fact:
# there is nothing to join with this tool.
wifi_state_value() {
  local c
  if c="$(nmcli_bin)"; then :; else printf '%s\t%s\n' unavailable nmcli; return 0; fi
  if "$c" -t -f DEVICE,TYPE dev status 2>/dev/null | awk -F: '$2=="wifi" { found = 1 } END { exit !found }'; then
    if [ -n "$(wifi_active_ssid)" ]; then printf '%s\t%s\n' connected nmcli; else printf '%s\t%s\n' disconnected nmcli; fi
  else
    printf '%s\t%s\n' unavailable nmcli
  fi
}

network_install_hint() {
  continuity_error "NetworkManager is not installed — sudo pacman -S networkmanager && sudo systemctl enable --now NetworkManager"
}

wifi_active_ssid() {
  local c
  c="$(nmcli_bin)" || return 0
  # ACTIVE,SSID as terse fields: the active row is the one we are joined to.
  # `read` gives the remainder to the last variable, so an SSID containing ':'
  # survives.
  while IFS=: read -r active ssid; do
    [ "$active" = "yes" ] && { printf '%s' "$ssid"; break; }
  done < <("$c" -t -f ACTIVE,SSID dev wifi list 2>/dev/null || true)
}

# "No SSID" means two different things: not joined (nmcli can say why) or no
# NetworkManager at all (nothing to ask). Only the second is `unset`.
ssid_line() {
  local s="$1" w="$2"
  if [ -z "$s" ] && [ "${w%%$'\t'*}" = "unavailable" ]; then
    printf '\tunset\n'
  else
    printf '%s\tnmcli\n' "$s"
  fi
}

# ---------------------------------------------------------------------------
# applying values (user scope), and system scope behind --system
# ---------------------------------------------------------------------------
write_keymap_block() {
  local layout="$1" variant="$2" file="$HYPR_LOCAL" work block header
  work="$(mktemp)" || continuity_die "cannot create a temporary file"

  if [ -e "$file" ]; then
    # Strip only our own fenced block: everything else the user wrote in
    # local.conf is theirs and must survive byte for byte.
    awk -v b="$MARK_BEGIN" -v e="$MARK_END" '
      $0 == b { skip = 1; next }
      $0 == e { skip = 0; next }
      skip != 1 { print }
    ' "$file" >"$work" || { rm -f "$work"; continuity_die "could not read $file"; }
  fi

  block="$(mktemp)" || continuity_die "cannot create a temporary file"
  {
    printf '%s\n' "$MARK_BEGIN"
    printf '# Written by continuity-region (first-run wizard). hyprland.conf sources\n'
    printf '# this file last, so it overrides conf.d/input.conf without editing it.\n'
    printf 'input {\n'
    printf '    kb_layout = %s\n' "$layout"
    if [ -n "$variant" ]; then printf '    kb_variant = %s\n' "$variant"; else printf '    kb_variant =\n'; fi
    printf '}\n'
    printf '%s\n' "$MARK_END"
  } >"$block"

  if [ "$DRY" = "1" ]; then
    printf 'would: write the keyboard block in %s\n' "$file"
    sed 's/^/    /' "$block"
    rm -f "$work" "$block"
    return 0
  fi

  if [ ! -s "$work" ]; then
    header="$(mktemp)" || continuity_die "cannot create a temporary file"
    {
      printf '%s\n' "# ContinuityOS — per-machine Hyprland overrides (sourced last)"
      printf '%s\n' "# Edit freely; continuity-region only owns the block it fences."
      printf '\n'
      cat "$work"
      cat "$block"
    } >"$header"
    mv "$header" "$work"
  else
    cat "$block" >>"$work"
  fi
  mkdir -p "$(dirname "$file")"
  mv "$work" "$file"
  rm -f "$block"
  return 0
}

apply_locale() {
  local lang="$1"
  if [ "$DRY" = "1" ]; then
    printf 'would: set LANG and LC_TIME to %s in %s and %s\n' "$lang" "$REGION_CONF" "$ENVD_DIR/10-continuity-region.conf"
  else
    continuity_ensure_dirs
    [ -e "$REGION_CONF" ] || {
      printf '%s\n' "# ContinuityOS — region settings (LOCALE/TIMEZONE). Sourced by continuity-shell." \
        "# Written by continuity-region; only LANG/LC_*/TZ are read from here." >"$REGION_CONF"
    }
    file_set "$REGION_CONF" LANG "$lang"
    file_set "$REGION_CONF" LC_TIME "$lang"
    mkdir -p "$ENVD_DIR"
    file_set "$ENVD_DIR/10-continuity-region.conf" LANG "$lang"
    file_set "$ENVD_DIR/10-continuity-region.conf" LC_TIME "$lang"
  fi

  # A locale that glibc has not generated silently falls back to C at login,
  # which looks like "the setting was ignored" rather than "the locale is
  # missing" — so say so now.
  local c
  if c="$(localectl_bin)"; then
    if ! "$c" list-locales 2>/dev/null | awk -v want="$lang" '$0 == want { found = 1 } END { exit !found }'; then
      # list-locales lists what glibc ships, not what this machine generated, so
      # this is a spelling check that doubles as the locale-gen hint.
      continuity_warn "glibc does not know '$lang' — sessions will fall back to C. Pick a name from 'continuity-region list-locales', then: uncomment it in /etc/locale.gen && sudo locale-gen"
    fi
  fi

  if [ "$SYSTEM" = "1" ]; then
    run_sudo localectl set-locale "LANG=$lang" || continuity_warn "localectl set-locale failed"
  fi
}

apply_keymap() {
  local layout="$1" variant="${2:-}"
  write_keymap_block "$layout" "$variant"
  if [ "$SYSTEM" = "1" ]; then
    run_sudo localectl set-keymap "$layout" || continuity_warn "localectl set-keymap failed"
    run_sudo localectl set-x11-keymap "$layout" "" "$variant" || continuity_warn "localectl set-x11-keymap failed"
  fi
}

apply_timezone() {
  local tz="$1"
  if [ "$DRY" = "1" ]; then
    printf 'would: set TZ=%s in %s and %s\n' "$tz" "$REGION_CONF" "$ENVD_DIR/10-continuity-region.conf"
  else
    continuity_ensure_dirs
    [ -e "$REGION_CONF" ] || {
      printf '%s\n' "# ContinuityOS — region settings (LOCALE/TIMEZONE). Sourced by continuity-shell." \
        "# Written by continuity-region; only LANG/LC_*/TZ are read from here." >"$REGION_CONF"
    }
    file_set "$REGION_CONF" TZ "$tz"
    mkdir -p "$ENVD_DIR"
    file_set "$ENVD_DIR/10-continuity-region.conf" TZ "$tz"
  fi
  if [ "$SYSTEM" = "1" ]; then
    run_sudo timedatectl set-timezone "$tz" || continuity_warn "timedatectl set-timezone failed"
  else
    # Be explicit rather than letting the user assume the whole machine changed.
    continuity_info "TZ applies to your sessions (and systemd --user); the system clock and other users need: sudo timedatectl set-timezone $tz"
  fi
}

# ---------------------------------------------------------------------------
# show / list
# ---------------------------------------------------------------------------
cmd_show() {
  local L LCT K V T S W SSID_LINE
  L="$(locale_value)"; LCT="$(lc_time_value)"; K="$(keymap_value)"
  V="$(variant_value)"; T="$(timezone_value)"
  S="$(wifi_active_ssid)"; W="$(wifi_state_value)"

  # "No SSID" means two different things: not joined (nmcli can tell you why) or
  # no NetworkManager at all (nothing to ask). Only the second is `unset`.
  if [ -z "$S" ] && [ "${W%%$'\t'*}" = "unavailable" ]; then
    SSID_LINE="$(printf '\tunset')"
  else
    SSID_LINE="$(printf '%s\tnmcli' "$S")"
  fi

  if [ "$JSON" = "1" ]; then
    printf '{'
    printf '"locale":%s,' "$(json_str "${L%%$'\t'*}")"
    printf '"lc_time":%s,' "$(json_str "${LCT%%$'\t'*}")"
    printf '"keymap":%s,' "$(json_str "${K%%$'\t'*}")"
    printf '"variant":%s,' "$(json_str "${V%%$'\t'*}")"
    printf '"timezone":%s,' "$(json_str "${T%%$'\t'*}")"
    printf '"wifi_ssid":%s,' "$(json_str "$S")"
    printf '"wifi_state":%s' "$(json_str "${W%%$'\t'*}")"
    printf '}\n'
    return 0
  fi

  # Every line is "key<TAB>value<TAB>source" — one tab-separated triple per
  # setting, so the wizard step can split each line once and trust the result.
  printf 'locale\t%s\n' "$L"
  printf 'lc_time\t%s\n' "$LCT"
  printf 'keymap\t%s\n' "$K"
  printf 'variant\t%s\n' "$V"
  printf 'timezone\t%s\n' "$T"
  printf 'wifi_ssid\t%s\n' "$SSID_LINE"
  printf 'wifi_state\t%s\n' "$W"
}

cmd_list_locales() {
  local c
  if c="$(localectl_bin)"; then "$c" list-locales; return 0; fi
  # No localectl (busy container, odd distro): the shipped SUPPORTED file is the
  # same source localectl reads.
  [ -r /usr/share/i18n/SUPPORTED ] && { awk '{ print $1 }' /usr/share/i18n/SUPPORTED; return 0; }
  continuity_warn "no locale list available — install systemd (localectl) or glibc's locale data"
  return 1
}

cmd_list_keymaps() {
  local c
  if c="$(localectl_bin)"; then "$c" list-keymaps; return 0; fi
  if [ -d /usr/share/kbd/keymaps ]; then
    find /usr/share/kbd/keymaps -name '*.map.gz' 2>/dev/null \
      | sed 's|.*/||; s|\.map\.gz$||' | sort -u
    return 0
  fi
  continuity_warn "no keymap list available — install kbd"
  return 1
}

cmd_list_timezones() {
  local c
  if c="$(timedatectl_bin)"; then "$c" list-timezones; return 0; fi
  if [ -d /usr/share/zoneinfo ]; then
    (cd /usr/share/zoneinfo && find . -type f 2>/dev/null \
      | sed 's|^\./||' \
      | grep -vE '^(posix|right)/' \
      | grep -vE '^([A-Za-z0-9_+-]+\.(tab|zi)|leapseconds|tzdata\.zi|\+VERSION)$' \
      | sort)
    return 0
  fi
  continuity_warn "no timezone list available — install tzdata"
  return 1
}

# ---------------------------------------------------------------------------
# autodetect
# ---------------------------------------------------------------------------
cmd_autodetect() {
  local loc km kmv tz found=0
  loc="$(locale_value)"
  km="$(keymap_value)"
  kmv="$(variant_value)"
  tz="$(timezone_value)"

  printf 'locale\t%s\n' "$loc"
  printf 'keymap\t%s\n' "$km"
  printf 'variant\t%s\n' "$kmv"
  printf 'timezone\t%s\n' "$tz"

  if [ "$APPLY" != "1" ]; then
    printf '%s\n' "# re-run with --apply to write the values whose source is not 'unset'"
    return 0
  fi

  # The values are split into "value<TAB>source" by the readers above; the layout
  # and its variant come from two separate calls, because the variant is a
  # different field in a different place, not the second field of this line.
  if [ -n "${loc%%$'\t'*}" ]; then apply_locale "${loc%%$'\t'*}"; found=1
  else continuity_warn "no locale to apply (nothing on this machine says which one)"; fi
  if [ -n "${km%%$'\t'*}" ]; then apply_keymap "${km%%$'\t'*}" "${kmv%%$'\t'*}"; found=1
  else continuity_warn "no keyboard layout to apply"; fi
  if [ -n "${tz%%$'\t'*}" ]; then apply_timezone "${tz%%$'\t'*}"; found=1
  else continuity_warn "no timezone to apply"; fi
  [ "$found" = "1" ] && continuity_ok "region settings applied" || continuity_warn "nothing was applied"
  return 0
}

# ---------------------------------------------------------------------------
# wifi
# ---------------------------------------------------------------------------
cmd_wifi_status() {
  local S W SSID_LINE
  S="$(wifi_active_ssid)"
  W="$(wifi_state_value)"
  SSID_LINE="$(ssid_line "$S" "$W")"
  if [ "$JSON" = "1" ]; then
    printf '{"wifi_ssid":%s,"wifi_state":%s}\n' "$(json_str "$S")" "$(json_str "${W%%$'\t'*}")"
  else
    printf 'wifi_ssid\t%s\n' "$SSID_LINE"
    printf 'wifi_state\t%s\n' "$W"
  fi
}

cmd_wifi_scan() {
  local c
  c="$(nmcli_bin)" || { network_install_hint; return 1; }

  # nmcli returns before the scan finishes; without the pause the list is the
  # previous one, which reads as "my network is not there".
  if [ "$DRY" = "1" ]; then
    printf 'would: %s dev wifi rescan\n' "$c"
  else
    "$c" dev wifi rescan >/dev/null 2>&1 || true
    sleep "${CONTINUITY_WIFI_SCAN_WAIT:-2}"
  fi

  # Strongest signal per SSID, strongest first. terse mode escapes ':' as '\:'.
  "$c" -t -f SSID,SIGNAL,SECURITY dev wifi list 2>/dev/null \
    | sed 's/\\:/:/g' \
    | awk -F: '
        NF && $1 != "" {
          if (!($1 in best) || $2 + 0 > best[$1] + 0) { best[$1] = $2 + 0; sec[$1] = $3 }
        }
        END {
          for (s in best) printf "%s\t%d\t%s\n", s, best[s], sec[s]
        }' \
    | sort -t$'\t' -k2,2nr \
    | awk -F'\t' '{ printf "%-32s %4s  %s\n", substr($1,1,32), $2, ($3 == "" ? "open" : $3) }' \
    || true

  return 0
}

# The passwd-file is created in a 0700 temp directory by cmd_wifi_connect and
# removed by this function; see the comment there for why it is not a `local`.
WIFI_TMPDIR=""
wifi_cleanup() {
  [ -n "$WIFI_TMPDIR" ] && rm -rf "$WIFI_TMPDIR"
  WIFI_TMPDIR=""
  return 0
}

cmd_wifi_connect() {
  local ssid="$1" c pass pw rc=0 out
  c="$(nmcli_bin)" || { network_install_hint; return 1; }
  [ -n "$ssid" ] || { printf '%s: wifi connect needs an SSID\n' "$PROG" >&2; exit 2; }

  if [ "$DRY" = "1" ]; then
    printf 'would: read the passphrase for "%s" from stdin and run %s dev wifi connect "%s" passwd-file <temp>\n' "$ssid" "$c" "$ssid"
    return 0
  fi

  if [ -t 0 ]; then
    printf 'Passphrase for "%s" (just press Enter for an open network): ' "$ssid" >&2
    IFS= read -rs pass || pass=""
    printf '\n' >&2
  else
    IFS= read -r pass || pass=""
  fi

  # A 0700 directory under the runtime dir (tmpfs, per-user, wiped at logout).
  # The variable is global and the cleanup idempotent because an EXIT trap runs
  # after a `local` has gone out of scope, where `set -u` would turn cleanup into
  # an error; the trap only covers the exits we do not reach (Ctrl-C, a kill).
  WIFI_TMPDIR="$(mktemp -d "${XDG_RUNTIME_DIR:-/tmp}/continuity-wifi.XXXXXX")" || continuity_die "cannot create a temporary directory"
  trap wifi_cleanup EXIT INT TERM
  pw="$WIFI_TMPDIR/passwd"
  (umask 077; printf '%s\n' "$pass" >"$pw")
  unset pass

  if [ -s "$pw" ] && [ -n "$(sed -n '1p' "$pw")" ]; then
    if out="$("$c" dev wifi connect "$ssid" passwd-file "$pw" 2>&1)"; then rc=0; else rc=$?; fi
  else
    if out="$("$c" dev wifi connect "$ssid" 2>&1)"; then rc=0; else rc=$?; fi
  fi

  if [ "$rc" != "0" ]; then
    # nmcli's own message is the useful one ("Secrets were required", "No network
    # with SSID …"); a generic error here would hide the actual reason.
    wifi_cleanup
    trap - EXIT INT TERM
    continuity_error "could not join \"$ssid\"${out:+: $out}"
    printf 'Try: %s dev wifi list\n' "$c" >&2
    return 1
  fi
  wifi_cleanup
  trap - EXIT INT TERM
  continuity_ok "connected to \"$ssid\""
  printf '%s\n' "${out:-connected}"
}

# ---------------------------------------------------------------------------
# locale / keymap / timezone commands
# ---------------------------------------------------------------------------
normalize_locale() {
  local lang="$1"
  case "$lang" in
    *.*|*@*) printf '%s' "$lang" ;;
    *) printf '%s.UTF-8' "$lang" ;;
  esac
}

cmd_locale() {
  local raw="$1" lang
  [ -n "$raw" ] || { printf '%s: locale needs a LANG (e.g. en_GB.UTF-8)\n' "$PROG" >&2; exit 2; }
  case "$raw" in
    *[!A-Za-z0-9_.@-]*) printf '%s: %s is not a locale name\n' "$PROG" "$raw" >&2; exit 2 ;;
  esac
  lang="$(normalize_locale "$raw")"
  apply_locale "$lang"
  [ "$DRY" = "1" ] || continuity_ok "locale: $lang (sessions, systemd --user)"
  return 0
}

cmd_keymap() {
  local layout="$1" variant="${2:-}"
  [ -n "$layout" ] || { printf '%s: keymap needs a LAYOUT (e.g. gb)\n' "$PROG" >&2; exit 2; }
  case "$layout" in
    *[!A-Za-z0-9_-]*) printf '%s: %s is not a keymap name\n' "$PROG" "$layout" >&2; exit 2 ;;
  esac
  # Hyprland's kb_layout values are lowercase (us, gb, de, dvorak).
  layout="$(printf '%s' "$layout" | tr '[:upper:]' '[:lower:]')"
  variant="$(printf '%s' "$variant" | tr '[:upper:]' '[:lower:]')"

  local c
  if c="$(localectl_bin)"; then
    if ! "$c" list-keymaps 2>/dev/null | awk -v want="$layout" '$0 == want { found = 1 } END { exit !found }'; then
      continuity_warn "'$layout' is not in the system keymap list — check 'continuity-region list-keymaps'"
    fi
  fi
  apply_keymap "$layout" "$variant"
  [ "$DRY" = "1" ] || continuity_ok "keyboard: ${layout}${variant:+ ($variant)}"
  return 0
}

cmd_timezone() {
  local tz="$1"
  [ -n "$tz" ] || { printf '%s: timezone needs AREA/CITY (e.g. Europe/London)\n' "$PROG" >&2; exit 2; }
  case "$tz" in
    *[!A-Za-z0-9_/+-]*) printf '%s: %s is not a timezone name\n' "$PROG" "$tz" >&2; exit 2 ;;
    */*) ;;
    *) continuity_warn "'$tz' has no AREA/CITY form (e.g. Europe/London)" ;;
  esac
  # When the tz database is present, a name that is not in it is a typo, and
  # writing it would leave the user with a UTC clock and no explanation.
  if [ -d /usr/share/zoneinfo ] && [ ! -e "/usr/share/zoneinfo/$tz" ]; then
    continuity_die "no such timezone: $tz (list them with: continuity-region list-timezones)"
  fi
  apply_timezone "$tz"
  [ "$DRY" = "1" ] || continuity_ok "timezone: $tz"
  return 0
}

# ---------------------------------------------------------------------------
# dispatch
# ---------------------------------------------------------------------------
case "$ACTION" in
  show)           cmd_show ;;
  autodetect)     cmd_autodetect ;;
  list-locales)   cmd_list_locales ;;
  list-keymaps)   cmd_list_keymaps ;;
  list-timezones) cmd_list_timezones ;;
  locale)         cmd_locale "${1:-}" ;;
  keymap)         cmd_keymap "${1:-}" "${2:-}" ;;
  timezone)       cmd_timezone "${1:-}" ;;
  wifi)
    case "${1:-}" in
      status)  cmd_wifi_status ;;
      scan)    cmd_wifi_scan ;;
      connect) cmd_wifi_connect "${2:-}" ;;
      *) printf '%s: wifi needs status|scan|connect\n' "$PROG" >&2; usage >&2; exit 2 ;;
    esac
    ;;
  -h|--help|help|"") usage ;;
  *) printf "%s: unknown command '%s'\n" "$PROG" "$ACTION" >&2; usage >&2; exit 2 ;;
esac
