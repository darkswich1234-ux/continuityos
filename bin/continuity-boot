#!/usr/bin/env bash
# ContinuityOS — boot straight into the desktop, and back again.
#
# A stock Arch install hands you a TTY login, and then you pick a session: that
# is `Arch -> Hyprland -> ContinuityOS`, three steps before anything works. This
# tool removes the first two for good, by configuring greetd so that
#
#   [initial_session] command = /usr/local/bin/continuity-shell
#
# runs once at boot with no greeter, no password and no session chooser. greetd
# only ever shows the greeter AFTER a session ends, i.e. on logout — which is
# deliberately kept working, because a machine whose only way in is a desktop
# that might be broken is a machine you reinstall.
#
#   continuity-boot on                 boot into ContinuityOS, no prompt
#   continuity-boot on --user anna     ...autologging in as somebody else
#   continuity-boot off                back to a TTY login (reversible)
#   continuity-boot status             what this machine actually does at boot
#   continuity-boot doctor             walk the whole chain, check by check
#
# It refuses to write anything that could leave a machine with no way in: no
# session binary, no such user, a root autologin, or a second display manager
# already owning the seat are all hard errors rather than a black screen.
set -euo pipefail

# --- locate the shared library ------------------------------------------------
_lib="${CONTINUITY_LIB:-}"
if [ -z "$_lib" ]; then
  for _p in \
    "$(cd "$(dirname "$0")" 2>/dev/null && pwd)/continuity-common.sh" \
    "$(cd "$(dirname "$0")/.." 2>/dev/null && pwd)/lib/continuity-common.sh" \
    /usr/local/lib/continuity/continuity-common.sh \
    /usr/lib/continuity/continuity-common.sh; do
    [ -r "$_p" ] && { _lib="$_p"; break; }
  done
fi
if [ -z "$_lib" ] || [ ! -r "$_lib" ]; then
  echo "continuity-boot: cannot locate continuity-common.sh (set CONTINUITY_LIB)" >&2
  exit 1
fi
# shellcheck source=../lib/continuity-common.sh
. "$_lib"

PROG="${0##*/}"
continuity_load_env

GREETD_DIR="${CONTINUITY_GREETD_DIR:-/etc/greetd}"
CONF="$GREETD_DIR/config.toml"
GREETD_UNIT="greetd.service"
# Unit search directories. Overridable so the whole chain can be exercised on a
# machine that has no greetd (and no systemd) at all: point these at a fixture
# directory and PATH at a stub systemctl, and `on --dry-run` becomes testable.
UNIT_DIR="${CONTINUITY_GREETD_UNIT_DIR:-/usr/lib/systemd/system}"
ETC_UNIT_DIR="${CONTINUITY_ETC_UNIT_DIR:-/etc/systemd/system}"
SESSION_COMMAND="${CONTINUITY_SESSION_COMMAND:-/usr/local/bin/continuity-shell}"
SESSION_DESKTOP="${CONTINUITY_SESSION_DESKTOP:-/usr/share/wayland-sessions/continuity.desktop}"
MARK_BEGIN="# >>> continuity-autologin"
MARK_END="# <<< continuity-autologin"

DRY_RUN=0
JSON=0
ACTION=""
# The rendered-config temp file. Global (not local) on purpose: the EXIT trap has
# to still see it, and locals are gone by the time that trap runs.
TMPFILE=""
WANT_USER=""
WANT_GREETER=""
WANT_VT=""

usage() {
  cat <<'EOF'
continuity-boot — boot straight into the ContinuityOS desktop, and back

USAGE
  continuity-boot status [--json]
  continuity-boot on [--user NAME] [--greeter tuigreet|agreety|none] [--vt N] [--dry-run]
  continuity-boot off [--dry-run]
  continuity-boot doctor
  continuity-boot --help

WHAT IT DOES
  on      renders /etc/greetd/config.toml from config/greetd/config.toml.tmpl and
          enables greetd.service. greetd starts the session in [initial_session]
          once, before any greeter is shown, so the next boot goes to the desktop.
          A logout then shows the greeter (a session chooser), which is the
          recovery path when the desktop itself is what broke.
  off     strips the autologin block, disables greetd.service and makes sure
          getty@tty1 is enabled again, so you get a normal TTY login back:
          log in, then run `continuity-shell`.
  status  what this machine is configured to do at boot, and whether the config
          on disk still matches this template (drift).
  doctor  checks the whole chain (binary, session file, greetd, greeter, user,
          competing display managers) and exits non-zero if any check errors.

OPTIONS
  --user NAME      account to autolog in (default: the invoking user; root is refused)
  --greeter NAME   the LOGOUT screen: tuigreet (default when installed), agreety,
                   or `none` for a bare shell prompt. Never shown at boot.
  --vt N           virtual console greetd takes over (default 1; also next|current)
  --dry-run        print every command and the rendered config; change nothing

ENVIRONMENT
  CONTINUITY_GREETD_DIR         config directory (default /etc/greetd)
  CONTINUITY_SESSION_COMMAND    session command (default /usr/local/bin/continuity-shell)
  CONTINUITY_GREETD_TEMPLATE    template to render (default: the repo/installed copy)
  CONTINUITY_GREETD_UNIT_DIR    where unit files are looked for (default
                                /usr/lib/systemd/system; for tests and fixtures)
  CONTINUITY_ETC_UNIT_DIR       the /etc/systemd/system equivalent
EOF
}

# ---------------------------------------------------------------------------
# privilege + honesty wrapper
# ---------------------------------------------------------------------------
# Writing /etc and calling systemctl need root. Every mutating action goes
# through run_root() so --dry-run is honest rather than decorative: in dry-run
# mode it prints the exact command line it would have run, sudo included.
if [ "$(id -u)" = "0" ]; then
  SUDO=""
elif continuity_have sudo; then
  SUDO="sudo"
else
  SUDO=""
fi

have_root_path() {
  [ "$(id -u)" = "0" ] || [ -n "$SUDO" ]
}

need_root_path() {
  local what="$1"
  have_root_path && return 0
  continuity_die "$what needs root and sudo is not installed — run this as root, or by hand:
  install -d -m 0755 $GREETD_DIR
  install -m 0644 <rendered-config> $CONF
  systemctl enable $GREETD_UNIT"
}

run_root() {
  if [ "$DRY_RUN" = "1" ]; then
    printf '  %s+ %s%s\n' "$_c_dim" "${SUDO:+$SUDO }" "$*" >&2
    return 0
  fi
  if [ -n "$SUDO" ]; then "$SUDO" "$@"; else "$@"; fi
}

cleanup_tmp() {
  [ -n "${TMPFILE:-}" ] && rm -f "$TMPFILE"
  return 0
}

# ---------------------------------------------------------------------------
# small queries
# ---------------------------------------------------------------------------
unit_file_exists() {
  [ -e "$UNIT_DIR/$1" ] || [ -e "$ETC_UNIT_DIR/$1" ] || return 1
  return 0
}

unit_enabled() {
  local out
  continuity_have systemctl || { printf 'unknown'; return 0; }
  out="$(systemctl is-enabled "$1" 2>/dev/null || true)"
  printf '%s' "${out:-unknown}"
}

unit_active() {
  local out
  continuity_have systemctl || { printf 'unknown'; return 0; }
  out="$(systemctl is-active "$1" 2>/dev/null || true)"
  printf '%s' "${out:-unknown}"
}

# The first *enabled* competing display manager, or nothing. Two DMs enabled at
# once fight over the seat, which is a black screen rather than an error.
competing_dm() {
  local dm out link target
  for dm in sddm.service lightdm.service gdm.service ly.service lxdm.service xdm.service; do
    out="$(systemctl is-enabled "$dm" 2>/dev/null || true)"
    case "$out" in enabled|enabled-runtime|alias) printf '%s' "$dm"; return 0 ;; esac
  done
  for link in /etc/systemd/system/display-manager.service /usr/lib/systemd/system/display-manager.service; do
    [ -L "$link" ] || continue
    target="$(readlink -f "$link" 2>/dev/null || true)"
    case "$target" in ""|*greetd.service) continue ;; esac
    # A dangling link (the DM was removed) must not block a legitimate switch.
    [ -e "$target" ] || continue
    printf '%s' "${target##*/}"
    return 0
  done
  return 1
}

# --- greeter resolution ------------------------------------------------------
# The greeter is only ever the logout screen, so the default is "whatever is
# installed", and tuigreet wins because it is the one that looks like a product.
greeter_bin() {
  continuity_have tuigreet && { printf 'tuigreet'; return 0; }
  continuity_have agreety && { printf 'agreety'; return 0; }
  return 1
}

greeter_command_for() {
  case "$1" in
    tuigreet) printf 'tuigreet --time --remember --cmd %s' "$SESSION_COMMAND" ;;
    agreety)  printf 'agreety --cmd %s' "$SESSION_COMMAND" ;;
    none)     printf '/bin/sh' ;;
    *)        return 1 ;;
  esac
}

# --- the template ------------------------------------------------------------
SCRIPT_DIR="$(cd "$(dirname "$0")" 2>/dev/null && pwd || printf '')"

template_path() {
  local p
  for p in "${CONTINUITY_GREETD_TEMPLATE:-}" \
           "${SCRIPT_DIR:+$SCRIPT_DIR/../config/greetd/config.toml.tmpl}" \
           /usr/share/continuity/config/greetd/config.toml.tmpl \
           /usr/local/share/continuity/config/greetd/config.toml.tmpl; do
    [ -n "$p" ] && [ -r "$p" ] && { printf '%s\n' "$p"; return 0; }
  done
  return 1
}

# Escape a replacement for sed's s||| command: backslash, & and the delimiter.
sed_escape() {
  printf '%s' "$1" | sed -e 's/[\\&|]/\\&/g'
}

conf_value() {
  # conf_value SECTION KEY FILE — value of KEY in [SECTION], quotes stripped.
  awk -v s="[$1]" -v k="$2" '
    /^[[:space:]]*#/ { next }
    /^\[/ { insec = ($0 == s); next }
    insec && $1 == k {
      line = $0
      sub(/^[^=]*=[[:space:]]*/, "", line)
      gsub(/^"|"$/, "", line)
      print line
      exit
    }
  ' "$3" 2>/dev/null || true
}

# Strip the fenced autologin block, markers included.
strip_autologin() {
  local file="$1" tmp="$1.nb"
  sed -e "/^[[:space:]]*${MARK_BEGIN}/,/^[[:space:]]*${MARK_END}/d" "$file" >"$tmp" || \
    { rm -f "$tmp"; return 1; }
  mv "$tmp" "$file"
}

# render_config OUT USER GREETER_COMMAND VT_AS_TOML MINUS_AUTOLOGIN(0|1)
render_config() {
  local out="$1" user="$2" greeter="$3" vt="$4" minus="$5" tpl
  tpl="$(template_path)" || return 1
  sed -e "s|@VT@|$(sed_escape "$vt")|g" \
      -e "s|@GREETER_COMMAND@|$(sed_escape "$greeter")|g" \
      -e "s|@SESSION_COMMAND@|$(sed_escape "$SESSION_COMMAND")|g" \
      -e "s|@AUTOLOGIN_USER@|$(sed_escape "$user")|g" \
      "$tpl" >"$out" || return 1
  [ "$minus" = "0" ] || strip_autologin "$out"
  return 0
}

# Validate what we are about to install. greetd, given a malformed file, does not
# start at all — on a machine whose only display manager it is, that is a black
# screen, so this is checked before anything is moved into place.
validate_config() {
  local file="$1" want_auto="$2" line
  [ -s "$file" ] || { continuity_error "the rendered config is empty"; return 1; }
  if ! grep -q '^\[default_session\]' "$file"; then
    continuity_error "the rendered config has no [default_session] section (greetd refuses to start without one)"
    return 1
  fi
  if [ "$want_auto" = "1" ]; then
    if ! grep -q '^\[initial_session\]' "$file"; then
      continuity_error "the rendered config lost its [initial_session] block — refusing to install an autologin that does not autologin"
      return 1
    fi
  else
    if grep -q '^\[initial_session\]' "$file"; then
      continuity_error "the rendered config still contains [initial_session] — refusing to install"
      return 1
    fi
  fi
  if grep -Eq '@[A-Z_]+@' "$file"; then
    continuity_error "the rendered config still has an unsubstituted placeholder: $(grep -Eo '@[A-Z_]+@' "$file" | sort -u | tr '\n' ' ')"
    return 1
  fi
  while IFS= read -r line; do
    case "$line" in ''|'#'*) continue ;; esac
    case "$line" in
      '['*']') continue ;;
      *'='*)   continue ;;
    esac
    continuity_error "the rendered config has a line that is neither a section nor key = value: $line"
    return 1
  done <"$file"
  return 0
}

resolve_user() {
  # resolve_user NAME -> prints NAME, or nothing. Refuses root and nologin shells.
  local name="$1" entry uid shell
  [ -n "$name" ] || return 1
  entry="$(getent passwd "$name" 2>/dev/null || true)"
  [ -n "$entry" ] || return 1
  uid="$(printf '%s\n' "$entry" | cut -d: -f3)"
  shell="$(printf '%s\n' "$entry" | cut -d: -f7)"
  case "$uid" in ''|0) return 1 ;; esac
  case "$shell" in ''|*/nologin|*/false) return 1 ;; esac
  printf '%s' "$name"
  return 0
}

vt_as_toml() {
  case "${1:-1}" in
    next|current) printf '"%s"' "$1" ;;
    *[!0-9]*) return 1 ;;
    '') printf '1' ;;
    *) printf '%s' "$1" ;;
  esac
}

# ---------------------------------------------------------------------------
# status
# ---------------------------------------------------------------------------
status_fields() {
  local autologin="off" user="" greeter="" greeter_bin_name="" vt="" drift="no" conf_present="no" session_present="no"
  if [ -r "$CONF" ]; then
    conf_present="yes"
    user="$(conf_value initial_session user "$CONF")"
    [ -n "$user" ] && autologin="on"
    greeter="$(conf_value default_session command "$CONF")"
    vt="$(conf_value terminal vt "$CONF")"
  fi
  [ -n "$greeter" ] && greeter_bin_name="${greeter%% *}" || greeter_bin_name=""
  [ -x "$SESSION_COMMAND" ] && session_present="yes"

  # Drift: re-render from the template using the values already configured and
  # compare. A machine that boots from a hand-edited file is not wrong, but it is
  # not what this tool would install either, and the next `on` would overwrite it.
  if [ "$conf_present" = "yes" ]; then
    local vt_toml tmp current_greeter current_greeter_bin current_vt
    current_vt="${vt:-1}"
    vt_toml="$(vt_as_toml "$current_vt" || printf '1')"
    current_greeter="$greeter"
    if [ -z "$current_greeter" ]; then
      current_greeter_bin="$(greeter_bin || printf agreety)"
      current_greeter="$(greeter_command_for "$current_greeter_bin" || printf 'agreety')"
    fi
    tmp="$(mktemp "${TMPDIR:-/tmp}/continuity-boot.XXXXXX")" 2>/dev/null || tmp=""
    if [ -n "$tmp" ]; then
      if render_config "$tmp" "${user:-$(id -un)}" "$current_greeter" "$vt_toml" "$([ "$autologin" = "on" ] && printf 0 || printf 1)"; then
        if ! cmp -s "$tmp" "$CONF" 2>/dev/null; then drift="yes"; fi
      else
        drift="unknown"
      fi
      rm -f "$tmp"
    else
      drift="unknown"
    fi
  fi

  STATUS_AUTOLOGIN="$autologin"
  STATUS_USER="$user"
  STATUS_GREETER="$greeter"
  STATUS_GREETER_BIN="$greeter_bin_name"
  STATUS_VT="${vt:-unset}"
  STATUS_DRIFT="$drift"
  STATUS_CONF_PRESENT="$conf_present"
  STATUS_SESSION_PRESENT="$session_present"
  STATUS_ENABLED="$(unit_enabled "$GREETD_UNIT")"
  STATUS_ACTIVE="$(unit_active "$GREETD_UNIT")"
}

cmd_status() {
  local json=0
  [ "${1:-}" = "--json" ] && json=1
  status_fields
  if [ "$json" = "1" ]; then
    printf '{'
    printf '"autologin":"%s",' "$STATUS_AUTOLOGIN"
    printf '"user":"%s",' "$STATUS_USER"
    printf '"greeter_command":"%s",' "$(json_escape "$STATUS_GREETER")"
    printf '"greeter_binary":"%s",' "$STATUS_GREETER_BIN"
    printf '"vt":"%s",' "$STATUS_VT"
    printf '"service_enabled":"%s",' "$STATUS_ENABLED"
    printf '"service_active":"%s",' "$STATUS_ACTIVE"
    printf '"config_file":"%s",' "$CONF"
    printf '"config_present":"%s",' "$STATUS_CONF_PRESENT"
    printf '"template_drift":"%s",' "$STATUS_DRIFT"
    printf '"session_command":"%s",' "$SESSION_COMMAND"
    printf '"session_present":"%s"' "$STATUS_SESSION_PRESENT"
    printf '}\n'
    return 0
  fi
  printf 'autologin      %s%s\n' "$STATUS_AUTOLOGIN" \
    "$([ "$STATUS_AUTOLOGIN" = "on" ] && printf " (as %s)" "$STATUS_USER")"
  printf 'greeter        %s\n' "${STATUS_GREETER:-none configured (this is the logout screen)}"
  printf 'greeter binary %s\n' "${STATUS_GREETER_BIN:-not found — the logout screen will not start}"
  printf 'console (vt)   %s\n' "$STATUS_VT"
  printf 'greetd service enabled=%s active=%s\n' "$STATUS_ENABLED" "$STATUS_ACTIVE"
  printf 'config         %s (%s)\n' "$CONF" \
    "$([ "$STATUS_CONF_PRESENT" = "yes" ] && printf present || printf missing)"
  printf 'template drift %s\n' "$STATUS_DRIFT"
  printf 'session        %s (%s)\n' "$SESSION_COMMAND" \
    "$([ "$STATUS_SESSION_PRESENT" = "yes" ] && printf present || printf 'MISSING — boot would fail, run install.sh --system')"
  if [ "$STATUS_AUTOLOGIN" = "on" ]; then
    printf '\nAt boot: the desktop, immediately, no prompt. Logging out shows the greeter.\n'
  else
    printf '\nAt boot: a TTY login. Run `continuity-shell` (or `continuity-boot on`) after logging in.\n'
  fi
}

json_escape() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  printf '%s' "$s"
}

# ---------------------------------------------------------------------------
# on
# ---------------------------------------------------------------------------
cmd_on() {
  need_root_path "installing $CONF"

  local user="$WANT_USER"
  if [ -z "$user" ]; then
    user="${SUDO_USER:-}"
    [ -n "$user" ] || user="$(id -un)"
  fi

  # Every refusal below happens before a single byte is written.
  if ! continuity_have systemctl; then
    continuity_die "systemd is required (this tool enables $GREETD_UNIT)"
  fi
  if ! unit_file_exists "$GREETD_UNIT"; then
    continuity_die "greetd is not installed — install it first:
  sudo pacman -S greetd greetd-tuigreet"
  fi
  if [ ! -x "$SESSION_COMMAND" ]; then
    continuity_die "$SESSION_COMMAND is missing or not executable — autologin would boot to a black screen.
  Install the session first:  sudo ./install.sh --system"
  fi
  local resolved
  if ! resolved="$(resolve_user "$user")"; then
    if [ "$user" = "root" ]; then
      continuity_die "refusing to autologin root — pass --user NAME"
    fi
    continuity_die "'$user' is not a usable login account (it must exist, not be root, and have a real login shell)"
  fi
  user="$resolved"
  local home
  home="$(getent passwd "$user" 2>/dev/null | cut -d: -f6 || true)"

  local dm
  if dm="$(competing_dm)"; then
    continuity_die "another display manager is enabled: $dm
Two of them fighting over the seat is a black screen, so nothing was changed. Disable it first:
  sudo systemctl disable $dm
then re-run: sudo continuity-boot on --user $user"
  fi

  # The greeter is the logout screen, never the boot path.
  local greeter_name="$WANT_GREETER" greeter_cmd=""
  if [ -z "$greeter_name" ]; then
    greeter_name="$(greeter_bin)" || continuity_die \
      "no greeter found — greetd needs one for the logout screen:
  sudo pacman -S greetd-tuigreet"
  fi
  case "$greeter_name" in
    tuigreet) continuity_have tuigreet || continuity_die "tuigreet is not installed (sudo pacman -S greetd-tuigreet)" ;;
    agreety)  continuity_have agreety  || continuity_die "agreety is not installed (it ships with greetd: sudo pacman -S greetd)" ;;
    none)     ;;
    *)        continuity_die "unknown greeter '$greeter_name' (want: tuigreet|agreety|none)" ;;
  esac
  greeter_cmd="$(greeter_command_for "$greeter_name")"

  local vt_toml
  vt_toml="$(vt_as_toml "${WANT_VT:-1}")" || continuity_die "--vt wants a console number, 'next' or 'current'"

  TMPFILE="$(mktemp "${TMPDIR:-/tmp}/continuity-boot.XXXXXX")"
  trap cleanup_tmp EXIT
  if ! render_config "$TMPFILE" "$user" "$greeter_cmd" "$vt_toml" 0; then
    continuity_die "cannot render the template — is it where install.sh put it? (looked for $(template_path || printf 'config/greetd/config.toml.tmpl'))"
  fi
  validate_config "$TMPFILE" 1 || continuity_die "refusing to install a config that failed validation (nothing was changed)"

  if [ "$DRY_RUN" = "1" ]; then
    continuity_info "dry run — this is what would be written to $CONF:"
    sed 's/^/    /' "$TMPFILE" >&2
  fi

  run_root install -d -m 0755 "$GREETD_DIR"
  run_root install -m 0644 "$TMPFILE" "$CONF"
  if [ "$DRY_RUN" = "1" ]; then
    run_root systemctl enable "$GREETD_UNIT"
  else
    run_root systemctl enable "$GREETD_UNIT" || \
      continuity_die "could not enable $GREETD_UNIT — enable it by hand: sudo systemctl enable $GREETD_UNIT"
  fi
  rm -f "$TMPFILE"
  TMPFILE=""
  trap - EXIT

  continuity_log "boot: autologin on (user=$user greeter=$greeter_name vt=${WANT_VT:-1})"
  continuity_ok "autologin enabled for $user"
  printf 'Next boot: ContinuityOS opens by itself — no login prompt, no session menu.\n'
  printf 'Logging out shows the %s greeter, which is the way back in if the desktop breaks.\n' "$greeter_name"
  if [ "$greeter_name" = "none" ]; then
    continuity_warn "greeter 'none' leaves a bare shell prompt on the console after logout, running as the
  unprivileged 'greeter' user. Recover on tty2 (Ctrl+Alt+F2) with your own account, then run continuity-shell."
  fi
  case "$home" in
    '') continuity_warn "could not resolve $user's home directory — check that the account is complete" ;;
    *)  [ -d "$home/.config/hypr" ] || continuity_warn "$home/.config/hypr is missing: provision it with
  sudo ./install.sh --user $user   (first boot does this automatically)" ;;
  esac
  return 0
}

# ---------------------------------------------------------------------------
# off
# ---------------------------------------------------------------------------
cmd_off() {
  local enabled
  enabled="$(unit_enabled "$GREETD_UNIT")"
  if [ ! -r "$CONF" ] && [ "$enabled" != "enabled" ] && [ "$enabled" != "enabled-runtime" ]; then
    continuity_info "autologin is already off (no $CONF, $GREETD_UNIT is $enabled) — nothing to do"
    return 0
  fi
  need_root_path "changing $CONF"

  local vt=1 greeter_cmd="" user vt_toml
  if [ -r "$CONF" ]; then
    user="$(conf_value initial_session user "$CONF")"
    greeter_cmd="$(conf_value default_session command "$CONF")"
    vt="$(conf_value terminal vt "$CONF")"; [ -n "$vt" ] || vt=1
  fi
  [ -n "$greeter_cmd" ] || greeter_cmd="$(greeter_command_for "$(greeter_bin || printf agreety)" || printf 'agreety --cmd /bin/sh')"

  TMPFILE="$(mktemp "${TMPDIR:-/tmp}/continuity-boot.XXXXXX")"
  trap cleanup_tmp EXIT
  vt_toml="$(vt_as_toml "$vt" || printf '1')"
  if render_config "$TMPFILE" "${user:-$(id -un)}" "$greeter_cmd" "$vt_toml" 1; then
    validate_config "$TMPFILE" 0 || continuity_die "refusing to install a config that failed validation (nothing was changed)"
  else
    # No template on disk: strip the block from a copy of the live file instead,
    # so `off` still works on a machine where the template was never installed.
    # The copy is made as the current user (reading /etc/greetd needs no root) so
    # the stripping below can write to it; the result is installed with root.
    # Either way the stripping happens on a copy, so a dry run shows the config
    # that would actually be written.
    continuity_warn "template not found — stripping the autologin block from $CONF directly"
    cp -a "$CONF" "$TMPFILE"
    strip_autologin "$TMPFILE"
    validate_config "$TMPFILE" 0 || continuity_die "refusing to install a config that failed validation (nothing was changed)"
  fi

  if [ "$DRY_RUN" = "1" ]; then
    continuity_info "dry run — this is what would be written to $CONF:"
    sed 's/^/    /' "$TMPFILE" >&2
  fi
  run_root install -d -m 0755 "$GREETD_DIR"
  run_root install -m 0644 "$TMPFILE" "$CONF"
  if unit_file_exists "$GREETD_UNIT"; then
    run_root systemctl disable "$GREETD_UNIT" || continuity_warn "could not disable $GREETD_UNIT — do it by hand"
  else
    continuity_warn "there is no $GREETD_UNIT on this machine — nothing to disable"
  fi

  # Never leave a machine whose only console is a display manager we just turned
  # off: make sure the plain TTY login exists again.
  case "$(unit_enabled getty@tty1.service)" in
    masked) run_root systemctl unmask getty@tty1.service || continuity_warn "could not unmask getty@tty1.service" ;;
  esac
  if [ "$DRY_RUN" = "1" ]; then
    run_root systemctl enable getty@tty1.service
  else
    run_root systemctl enable getty@tty1.service >/dev/null 2>&1 || \
      continuity_warn "could not enable getty@tty1.service — check it by hand before rebooting"
  fi
  rm -f "$TMPFILE"
  TMPFILE=""
  trap - EXIT

  continuity_log "boot: autologin off"
  continuity_ok "autologin disabled — greetd stays installed, it just no longer starts a session for you"
  printf 'Next boot: a normal TTY login. After logging in, start the desktop with:\n'
  printf '    continuity-shell\n'
  printf 'To put it back:  sudo continuity-boot on\n'
  return 0
}

# ---------------------------------------------------------------------------
# doctor
# ---------------------------------------------------------------------------
DOCTOR_ERRORS=0
doctor_line() {
  # doctor_line ok|warn|error CHECK DETAIL
  local level="$1" check="$2" detail="$3"
  printf '%s %s %s\n' "$level" "$check" "$detail"
  [ "$level" = "error" ] && DOCTOR_ERRORS=$((DOCTOR_ERRORS + 1))
  return 0
}

cmd_doctor() {
  status_fields
  local home shell uid dm

  if [ -x "$SESSION_COMMAND" ]; then
    doctor_line ok session-binary "$SESSION_COMMAND is executable"
  else
    doctor_line error session-binary "missing or not executable: $SESSION_COMMAND (sudo ./install.sh --system)"
  fi

  if [ -r "$SESSION_DESKTOP" ]; then
    doctor_line ok session-file "$SESSION_DESKTOP present"
  else
    doctor_line warn session-file "$SESSION_DESKTOP missing — a login manager cannot list the session (only matters if you use one)"
  fi

  if unit_file_exists "$GREETD_UNIT"; then
    doctor_line ok greetd "unit present ($GREETD_UNIT enabled=$STATUS_ENABLED active=$STATUS_ACTIVE)"
  else
    doctor_line error greetd "$GREETD_UNIT is not installed (sudo pacman -S greetd greetd-tuigreet)"
  fi

  if [ -n "$STATUS_GREETER_BIN" ] && continuity_have "$STATUS_GREETER_BIN"; then
    doctor_line ok greeter "$STATUS_GREETER_BIN found (logout screen)"
  elif [ -n "$STATUS_GREETER_BIN" ]; then
    doctor_line error greeter "the configured greeter '$STATUS_GREETER_BIN' does not exist — a logout would leave greetd unable to start a session"
  else
    doctor_line warn greeter "no greeter configured"
  fi

  if [ "$STATUS_AUTOLOGIN" = "on" ]; then
    home="$(getent passwd "$STATUS_USER" | cut -d: -f6 || true)"
    shell="$(getent passwd "$STATUS_USER" | cut -d: -f7 || true)"
    uid="$(getent passwd "$STATUS_USER" | cut -d: -f3 || true)"
    case "$uid" in
      ''|0) doctor_line error autologin-user "'$STATUS_USER' does not exist (or is root) — the next boot would fail" ;;
      *)    doctor_line ok autologin-user "$STATUS_USER (uid $uid, shell ${shell:-?}, home ${home:-?})" ;;
    esac
    case "$home" in
      '') ;;
      *) [ -d "$home" ] || doctor_line error autologin-home "$home does not exist" ;;
    esac
    local rel
    for rel in hypr eww continuity; do
      case "$home" in '') break ;; esac
      [ -d "$home/.config/$rel" ] || doctor_line warn "user-config-$rel" "$home/.config/$rel missing (sudo ./install.sh --user $STATUS_USER)"
    done
  else
    doctor_line ok autologin-user "autologin is off — a TTY login comes up, then continuity-shell"
  fi

  if dm="$(competing_dm)"; then
    doctor_line error display-manager "$dm is enabled as well — only one display manager may own the seat"
  else
    doctor_line ok display-manager "no competing display manager enabled"
  fi

  if [ -r "$CONF" ]; then
    local mode owner
    mode="$(stat -c '%a' "$CONF" 2>/dev/null || printf '?')"
    owner="$(stat -c '%U:%G' "$CONF" 2>/dev/null || printf '?')"
    case "$mode" in 644|640|600) doctor_line ok config-perms "$CONF $mode $owner" ;; *) doctor_line warn config-perms "$CONF is $mode — expected 0644" ;; esac
    if validate_config "$CONF" "$([ "$STATUS_AUTOLOGIN" = "on" ] && printf 1 || printf 0)" >/dev/null 2>&1; then
      doctor_line ok config-parse "$CONF parses as a greetd config"
    else
      doctor_line error config-parse "$CONF is not a valid greetd config — rewrite it with: sudo continuity-boot on"
    fi
    case "$STATUS_DRIFT" in
      yes)     doctor_line warn config-drift "$CONF differs from this template; the next 'continuity-boot on' would rewrite it" ;;
      unknown) doctor_line warn config-drift "could not re-render the template to compare" ;;
      *)       doctor_line ok config-drift "$CONF matches the template" ;;
    esac
  else
    doctor_line warn config "no $CONF — boot goes to a TTY login"
  fi

  if [ "$DOCTOR_ERRORS" -gt 0 ]; then
    printf '%s check(s) failed — fix the errors above before rebooting.\n' "$DOCTOR_ERRORS"
    return 1
  fi
  printf 'all checks passed — the boot chain is intact.\n'
  return 0
}

# ---------------------------------------------------------------------------
# dispatch
# ---------------------------------------------------------------------------
while [ $# -gt 0 ]; do
  case "$1" in
    on|off|status|doctor)
      [ -z "$ACTION" ] || { continuity_error "only one command may be given"; usage >&2; exit 2; }
      ACTION="$1"; shift ;;
    --user)    [ -n "${2:-}" ] || { continuity_error "--user needs a name"; exit 2; }; WANT_USER="$2"; shift 2 ;;
    --greeter) [ -n "${2:-}" ] || { continuity_error "--greeter needs a name"; exit 2; }; WANT_GREETER="$2"; shift 2 ;;
    --vt)      [ -n "${2:-}" ] || { continuity_error "--vt needs a console number"; exit 2; }; WANT_VT="$2"; shift 2 ;;
    --dry-run) DRY_RUN=1; shift ;;
    --json)    JSON=1; shift ;;
    -h|--help|help) usage; exit 0 ;;
    *) continuity_error "unknown argument '$1'"; usage >&2; exit 2 ;;
  esac
done
[ -n "$ACTION" ] || { usage >&2; exit 2; }

case "$ACTION" in
  on)
    [ -z "$WANT_GREETER" ] || case "$WANT_GREETER" in tuigreet|agreety|none) ;; *) continuity_die "unknown greeter '$WANT_GREETER' (want: tuigreet|agreety|none)" ;; esac
    cmd_on
    ;;
  off)    cmd_off ;;
  status) if [ "$JSON" = "1" ]; then cmd_status --json; else cmd_status; fi ;;
  doctor) cmd_doctor ;;
esac
