#!/usr/bin/env bash
# ContinuityOS — screenshot helper (bound to PRINT and Super+Shift+S).
#
#   continuity-screenshot region    drag a rectangle (Android-style "crop")
#   continuity-screenshot full      whole output
#   continuity-screenshot window    the focused window
#   continuity-screenshot menu      pick region/window/output with rofi
#
# Saves into ~/Pictures/Screenshots, copies to the clipboard when wl-clipboard is
# installed, and confirms with a notification.
set -euo pipefail

_lib="${CONTINUITY_LIB:-}"
if [ -z "$_lib" ]; then
  for _p in \
    "$(cd "$(dirname "$0")" 2>/dev/null && pwd)/continuity-common.sh" \
    "$(cd "$(dirname "$0")/.." 2>/dev/null && pwd)/lib/continuity-common.sh" \
    /usr/local/lib/continuity/continuity-common.sh \
    /usr/lib/continuity/continuity-common.sh; do
    [ -r "$_p" ] && { _lib="$_p"; break; }
  done
fi
[ -r "${_lib:-}" ] || { echo "continuity-screenshot: cannot locate continuity-common.sh" >&2; exit 1; }
# shellcheck source=../lib/continuity-common.sh
. "$_lib"

continuity_load_env

OUT_DIR="${XDG_PICTURES_DIR:-$HOME/Pictures}/Screenshots"
mkdir -p "$OUT_DIR"
STAMP="$(date +%Y%m%d-%H%M%S)"
OUT="$OUT_DIR/continuity-$STAMP.png"

MODE="${1:-region}"
if [ "$MODE" = "menu" ]; then
  if continuity_have rofi; then
    choice="$(printf 'Region\nWindow\nWhole screen\n' | rofi -dmenu -i -p Screenshot)" || exit 0
    case "$choice" in
      Region) MODE=region ;;
      Window) MODE=window ;;
      "Whole screen") MODE=full ;;
      *) exit 0 ;;
    esac
  else
    MODE=region
  fi
fi

continuity_have grim || continuity_die "grim is required (sudo pacman -S grim)"

capture() {
  case "$MODE" in
    region)
      continuity_have slurp || continuity_die "slurp is required for region capture (sudo pacman -S slurp)"
      local geom
      geom="$(slurp)" || exit 0   # user cancelled the drag
      grim -g "$geom" "$OUT"
      ;;
    window)
      local geom
      geom="$(hyprctl activewindow -j 2>/dev/null | tr -d '\n' | sed -n 's/.*"at":\[\([0-9-]*\),\([0-9-]*\)\].*"size":\[\([0-9]*\),\([0-9]*\)\].*/\1,\2 \3x\4/p')"
      if [ -n "$geom" ]; then
        # shellcheck disable=SC2086
        grim -g "$geom" "$OUT"
      else
        continuity_warn "could not read the focused window geometry; capturing the whole screen"
        grim "$OUT"
      fi
      ;;
    full) grim "$OUT" ;;
    *) continuity_die "unknown mode '$MODE' (region|window|full|menu)" ;;
  esac
}

capture

if continuity_have wl-copy; then
  wl-copy <"$OUT" && continuity_debug "copied to clipboard"
fi
if continuity_have notify-send; then
  notify-send -i "$OUT" 'Screenshot saved' "$(basename "$OUT")" 2>/dev/null || true
fi
printf '%s\n' "$OUT"
