#!/usr/bin/env bash
# ContinuityOS — Steam Linux Runtime (steamrt) seeder & validator.
#
# umu-run boots Proton inside a Steam Linux Runtime container. It downloads the
# runtime once into ~/.local/share/umu/<variant>/ and validates that tree with its
# own checks. When that tree is missing or half-written (interrupted download, a
# package upgrade, a copied home directory) umu aborts with messages like:
#
#   steamrt3 validation failed
#   File does not exist: '<path>/pressure-vessel/bin/pv-verify'
#   Could not find steamrt3_platform_* in '<path>'
#
# This tool makes that a non-event: it validates every runtime present, repairs
# from a prebundled archive (/usr/share/continuity/umu-runtimes) or the umu cache,
# and can symlink a read-only system runtime instead of copying gigabytes per user.
#
#   continuity-umu-verify                  validate what is installed (default)
#   continuity-umu-verify --check          same, but also report missing variants
#   continuity-umu-verify --seed           repair/seed from bundled + cached archives
#   continuity-umu-verify --force          reseed even valid runtimes
#   continuity-umu-verify steamrt3 --seed  restrict to one variant
#   continuity-umu-verify --quiet          silent success (for hooks/services)
#
# EXIT: 0 = every known variant valid, 1 = at least one invalid, 2 = invalid and
#       no local source available to repair it (needs network / manual archive).
set -euo pipefail

_lib="${CONTINUITY_LIB:-}"
if [ -z "$_lib" ]; then
  for _p in \
    "$(cd "$(dirname "$0")" 2>/dev/null && pwd)/continuity-common.sh" \
    "$(cd "$(dirname "$0")/.." 2>/dev/null && pwd)/lib/continuity-common.sh" \
    /usr/local/lib/continuity/continuity-common.sh \
    /usr/lib/continuity/continuity-common.sh; do
    [ -r "$_p" ] && { _lib="$_p"; break; }
  done
fi
[ -r "${_lib:-}" ] || { echo "continuity-umu-verify: cannot locate continuity-common.sh" >&2; exit 1; }
# shellcheck source=../lib/continuity-common.sh
. "$_lib"

PROG="${0##*/}"
ACTION="validate"
QUIET=0
FORCE=0
WANT_VARIANTS=()

usage() {
  cat <<'EOF'
continuity-umu-verify — seed, validate and repair the Steam Linux Runtime used by umu-run

USAGE
  continuity-umu-verify [--check|--seed|--force|--quiet] [variant...]

OPTIONS
  --check        Validate installed runtimes and list missing ones (exit 1 if any)
  --seed         Repair/replace invalid runtimes from a local source (default action
                 becomes --seed when a source exists). Copies or symlinks as configured.
  --force        Re-extract runtimes even when they currently validate
  --quiet        Only report failures
  -h, --help     This help

LAYOUT (must match umu's expectations)
  ~/.local/share/umu/
  ├── umu.lock
  ├── umu-shim
  └── steamrt3/
      ├── pressure-vessel/bin/pv-verify      <- validator umu requires
      ├── steamrt3_platform_<id>/files/      <- the actual platform payload
      ├── _v2-entry-point                    <- container entry point
      └── umu -> _v2-entry-point

LOCAL SOURCES FOR REPAIR (checked in order)
  /usr/share/continuity/umu-runtimes/<variant>/          (unpacked, read-only)
  /usr/share/continuity/umu-runtimes/<variant>.tar.zst   (archive)
  /usr/share/continuity/umu-runtimes/<variant>.tar.gz
  ~/.cache/umu/<variant>.tar.zst
  ~/.cache/umu/<variant>.tar.gz

ENVIRONMENT
  CONTINUITY_UMU_ROOT       runtime data dir (default ~/.local/share/umu)
  CONTINUITY_BUNDLED_RUNTIMES   prebundled source dir (default /usr/share/continuity/umu-runtimes)
  CONTINUITY_UMU_LINK=1     symlink prebundled runtimes instead of copying them
                            (saves disk on multi-user machines; pair with
                             CONTINUITY_UMU_RUNTIME_UPDATE=0 so umu does not try
                             to rewrite a read-only system tree)
  CONTINUITY_UMU_VARIANTS   space-separated variants to expect (default: discovered)
EOF
}

while [ $# -gt 0 ]; do
  case "$1" in
    --check)  ACTION="check"; shift ;;
    --seed|--repair) ACTION="seed"; shift ;;
    --validate) ACTION="validate"; shift ;;
    --force)  FORCE=1; shift ;;
    --quiet|-q) QUIET=1; shift ;;
    -h|--help|help) usage; exit 0 ;;
    -*) continuity_die "unknown option '$1' (see --help)" ;;
    *) WANT_VARIANTS+=("$1"); shift ;;
  esac
done

continuity_load_env
: "${CONTINUITY_UMU_ROOT:=$XDG_DATA_HOME/umu}"
: "${CONTINUITY_BUNDLED_RUNTIMES:=/usr/share/continuity/umu-runtimes}"
: "${CONTINUITY_UMU_LINK:=0}"
: "${CONTINUITY_UMU_RUNTIME_UPDATE:=1}"
mkdir -p "$CONTINUITY_UMU_ROOT" "$XDG_CACHE_HOME/umu" 2>/dev/null || true

log()    { [ "$QUIET" = "1" ] && return 0; continuity_info "$@"; }
failures=0
missing=0
repaired=0

# --- discovery ----------------------------------------------------------------
# Variants already present on disk.
discover_installed_variants() {
  [ -d "$CONTINUITY_UMU_ROOT" ] || return 0
  find "$CONTINUITY_UMU_ROOT" -maxdepth 1 -mindepth 1 -type d -name 'steamrt*' -printf '%f\n' 2>/dev/null | sort -V
}

# Variants we would like to have, from every source we can read.
discover_expected_variants() {
  local v
  for v in "${WANT_VARIANTS[@]:-}"; do [ -n "$v" ] && printf '%s\n' "$v"; done
  for v in ${CONTINUITY_UMU_VARIANTS:-}; do printf '%s\n' "$v"; done
  # From the prebundled tree / archives.
  if [ -d "$CONTINUITY_BUNDLED_RUNTIMES" ]; then
    find "$CONTINUITY_BUNDLED_RUNTIMES" -maxdepth 1 -mindepth 1 -printf '%f\n' 2>/dev/null \
      | sed -e 's/\.tar\.zst$//' -e 's/\.tar\.gz$//' | grep -E '^steamrt[0-9]+$' || true
  fi
  # From the umu cache.
  find "$XDG_CACHE_HOME/umu" -maxdepth 1 -mindepth 1 -name 'steamrt*.tar.*' -printf '%f\n' 2>/dev/null \
    | sed -e 's/\.tar\.zst$//' -e 's/\.tar\.gz$//' | grep -E '^steamrt[0-9]+$' || true
  # From an explicitly configured Proton build (toolmanifest.vdf "require_tool_appid").
  if [ -n "${PROTONPATH:-}" ] && [ -f "$PROTONPATH/toolmanifest.vdf" ]; then
    grep -oiE 'sniper|soldier|steamrt[0-9]' "$PROTONPATH/toolmanifest.vdf" 2>/dev/null \
      | tr '[:upper:]' '[:lower:]' \
      | sed -e 's/^soldier$/steamrt2/' -e 's/^sniper$/steamrt3/' || true
  fi
}

# --- validation (mirrors umu's own checks, same message shape) -----------------
validate_variant() {
  local variant="$1" root="$CONTINUITY_UMU_ROOT/$variant"
  if [ ! -d "$root" ]; then
    printf '%s validation failed\n' "$variant"
    printf '  runtime directory is missing: %s\n' "$root"
    return 1
  fi
  if [ ! -x "$root/pressure-vessel/bin/pv-verify" ] && [ ! -f "$root/pressure-vessel/bin/pv-verify" ]; then
    printf '%s validation failed\n' "$variant"
    printf '  File does not exist: %s\n' "$root/pressure-vessel/bin/pv-verify"
    return 1
  fi
  local platform
  platform="$(find "$root" -maxdepth 1 -mindepth 1 -type d -name "${variant}_platform_*" -print -quit 2>/dev/null || true)"
  if [ -z "$platform" ]; then
    printf '%s validation failed\n' "$variant"
    printf "  Could not find %s_platform_* in '%s'\n" "$variant" "$root"
    return 1
  fi
  # Informational only — umu tolerates a missing entry point until launch time,
  # but a truncated extraction usually shows up here first.
  if [ ! -e "$root/_v2-entry-point" ] && [ ! -e "$root/umu" ]; then
    printf '%s validation warning\n' "$variant"
    printf "  _v2-entry-point (umu) not found in '%s' — extraction looks incomplete\n" "$root"
  fi
  return 0
}

# --- repair -------------------------------------------------------------------
find_source() {
  local variant="$1"
  local cand
  for cand in \
    "$CONTINUITY_BUNDLED_RUNTIMES/$variant" \
    "$CONTINUITY_BUNDLED_RUNTIMES/$variant.tar.zst" \
    "$CONTINUITY_BUNDLED_RUNTIMES/$variant.tar.gz" \
    "$XDG_CACHE_HOME/umu/$variant.tar.zst" \
    "$XDG_CACHE_HOME/umu/$variant.tar.gz"; do
    [ -e "$cand" ] && { printf '%s\n' "$cand"; return 0; }
  done
  return 1
}

seed_variant() {
  local variant="$1" src="$2" dest="$CONTINUITY_UMU_ROOT/$variant"
  continuity_require tar "sudo pacman -S tar"

  if [ -d "$src" ]; then
    if [ "${CONTINUITY_UMU_LINK:-0}" = "1" ]; then
      rm -rf -- "$dest"
      ln -s -- "$src" "$dest"
      log "linked $variant -> $src (read-only system runtime)"
    else
      rm -rf -- "$dest"
      mkdir -p "$dest"
      # cp -a preserves the symlinks inside the runtime tree.
      cp -a -- "$src/." "$dest/"
      log "copied $variant from $src"
    fi
    return 0
  fi

  case "$src" in
    *.tar.zst)
      continuity_have zstd || { continuity_warn "zstd missing, cannot unpack $src"; return 1; }
      rm -rf -- "$dest"; mkdir -p "$dest"
      zstd -dc -- "$src" | tar -xf - -C "$dest" --strip-components=1 2>/dev/null \
        || zstd -dc -- "$src" | tar -xf - -C "$dest"
      ;;
    *.tar.gz)
      rm -rf -- "$dest"; mkdir -p "$dest"
      tar -xzf "$src" -C "$dest" --strip-components=1 2>/dev/null || tar -xzf "$src" -C "$dest"
      ;;
    *) return 1 ;;
  esac
  log "extracted $variant from $src"
  return 0
}

# --- main ---------------------------------------------------------------------
mapfile -t installed < <(discover_installed_variants)
mapfile -t expected  < <(discover_expected_variants | sort -u -V)

# Nothing installed and nothing expected: report the canonical set so a first
# launch is predictable rather than surprising.
if [ "${#installed[@]}" -eq 0 ] && [ "${#expected[@]}" -eq 0 ]; then
  expected=(steamrt3)
fi

# Installed runtimes are always validated, even if not "expected".
declare -A seen=()
targets=()
for v in ${installed[@]+"${installed[@]}"}; do
  [ -n "$v" ] || continue
  [ -n "${seen[$v]:-}" ] && continue
  seen[$v]=1; targets+=("$v")
done
for v in ${expected[@]+"${expected[@]}"}; do
  [ -n "$v" ] || continue
  [ -n "${seen[$v]:-}" ] && continue
  seen[$v]=1; targets+=("$v")
done

log "runtime root: $CONTINUITY_UMU_ROOT"
log "checking: ${targets[*]:-<none>}"

for variant in ${targets[@]+"${targets[@]}"}; do
  if [ "$FORCE" != "1" ] && validate_variant "$variant"; then
    log "  ok   $variant"
    continue
  fi

  if [ "$ACTION" = "check" ]; then
    if [ -d "$CONTINUITY_UMU_ROOT/$variant" ]; then
      failures=$((failures+1))
    else
      missing=$((missing+1))
      printf '%s is not installed yet\n' "$variant"
    fi
    continue
  fi

  if [ "$FORCE" != "1" ] && [ "${ACTION}" = "validate" ] && [ ! -d "$CONTINUITY_UMU_ROOT/$variant" ]; then
    # Not an error: umu downloads it on first launch.
    log "  new  $variant (will be downloaded by umu on first launch)"
    continue
  fi

  if src="$(find_source "$variant")"; then
    if seed_variant "$variant" "$src" && validate_variant "$variant" >/dev/null 2>&1; then
      repaired=$((repaired+1))
      log "  fixed $variant"
      continue
    fi
    continuity_warn "repair of $variant from $src did not produce a valid tree"
  fi

  # Could not repair locally.
  if [ -d "$CONTINUITY_UMU_ROOT/$variant" ]; then
    validate_variant "$variant" || true
    failures=$((failures+1))
    [ "$QUIET" = "1" ] || continuity_error "  $variant is present but invalid; re-run with --seed after providing an archive, or delete $CONTINUITY_UMU_ROOT/$variant and let umu re-download it"
  else
    missing=$((missing+1))
    log "  miss $variant (no local source; umu will download it on first launch — an internet connection is required for that first setup)"
  fi
done

if [ "$repaired" -gt 0 ]; then
  continuity_log "umu-verify: repaired $repaired runtime(s)"
  [ "$QUIET" = "1" ] || continuity_ok "repaired $repaired runtime(s)"
fi

if [ "$failures" -gt 0 ]; then
  exit 1
fi
if [ "$ACTION" = "check" ] && [ "$missing" -gt 0 ]; then
  exit 1
fi
[ "$QUIET" = "1" ] || continuity_ok "runtime set is valid"
exit 0
