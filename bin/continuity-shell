#!/usr/bin/env bash
# ContinuityOS — session entry point (used by /usr/share/wayland-sessions/continuity.desktop).
#
# Sets the session environment, then hands the process over to Hyprland. Anything
# that must exist before the compositor starts belongs here; anything after it
# belongs in continuity-session-start (Hyprland's exec-once).
set -euo pipefail

_lib="${CONTINUITY_LIB:-}"
if [ -z "$_lib" ]; then
  for _p in \
    "$(cd "$(dirname "$0")" 2>/dev/null && pwd)/continuity-common.sh" \
    "$(cd "$(dirname "$0")/.." 2>/dev/null && pwd)/lib/continuity-common.sh" \
    /usr/local/lib/continuity/continuity-common.sh \
    /usr/lib/continuity/continuity-common.sh; do
    [ -r "$_p" ] && { _lib="$_p"; break; }
  done
fi
[ -r "${_lib:-}" ] || { echo "continuity-shell: cannot locate continuity-common.sh" >&2; exit 1; }
# shellcheck source=../lib/continuity-common.sh
. "$_lib"

continuity_load_env
continuity_ensure_dirs

# --- region (locale, timezone) ------------------------------------------------
# Written by continuity-region, and deliberately re-applied here as well as in
# ~/.config/environment.d: environment.d only reaches systemd --user services,
# while LANG/TZ have to be in the environment of the compositor and everything
# it spawns (Wayland clients, Proton, games). The file is a plain KEY=VALUE
# fragment shared with environment.d, so it is sourced with `set -a` rather than
# exporting a fixed list — exporting an unset LC_ALL as empty would silently
# override the locale with nothing.
REGION_FILE="$CONTINUITY_CONFIG_DIR/region.conf"
if [ -r "$REGION_FILE" ]; then
  if [ "$(stat -c '%u' "$REGION_FILE" 2>/dev/null || echo 0)" != "$(id -u)" ]; then
    continuity_warn "ignoring $REGION_FILE (not owned by you)"
  elif [ -n "$(find "$REGION_FILE" -perm /022 -print -quit 2>/dev/null)" ]; then
    continuity_warn "ignoring $REGION_FILE (world/group writable)"
  else
    set -a
    # shellcheck disable=SC1090
    . "$REGION_FILE"
    set +a
    continuity_debug "region: LANG=${LANG:-unset} TZ=${TZ:-unset}"
  fi
fi

# --- environment --------------------------------------------------------------
# Also declared in hyprland.conf; they are set here so child processes inherit
# them even before the compositor exports anything.
export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP="Hyprland"
export XDG_SESSION_DESKTOP="ContinuityOS"
export XDG_SESSION_CLASS=user
export ELECTRON_OZONE_PLATFORM_HINT="${ELECTRON_OZONE_PLATFORM_HINT:-auto}"
export QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-wayland;wayland;xcb}"
export GDK_BACKEND="${GDK_BACKEND:-wayland,x11}"
export MOZ_ENABLE_WAYLAND=1
export _JAVA_AWT_WM_NONREPARENTING=1
export GTK_THEME="${GTK_THEME:-Continuity-Dark}"
export XCURSOR_THEME="${XCURSOR_THEME:-Adwaita}"
export XCURSOR_SIZE="${XCURSOR_SIZE:-24}"

# Keep systemd --user and dbus in the session's context.
if continuity_have dbus-update-activation-environment; then
  dbus-update-activation-environment --systemd \
    WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE XDG_SESSION_DESKTOP \
    CONTINUITY_PREFIX_ROOT >/dev/null 2>&1 || true
fi
if continuity_have systemctl; then
  systemctl --user import-environment \
    WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE >/dev/null 2>&1 || true
fi

# Log the session so "why did my shell not start" has an answer on disk.
continuity_log "session start (user=$(id -un) tty=${XDG_VTNR:-?} kernel=$(uname -r))"

# --- hand over to the compositor ---------------------------------------------
# `start-hyprland` is the wrapper newer Hyprland releases ship (it sets up the
# environment correctly, handles the crash-handler and, on some builds, the Lua
# config); plain `Hyprland` is always present.
for bin in start-hyprland Hyprland hyprland; do
  if continuity_have "$bin"; then
    continuity_info "starting Hyprland via $bin"
    # If the session ends, make sure the shell's children go with it.
    trap '' HUP
    exec "$bin" "$@"
  fi
done

continuity_die "Hyprland is not installed (sudo pacman -S hyprland)"
