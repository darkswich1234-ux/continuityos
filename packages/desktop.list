# ContinuityOS — Android-like desktop shell (official repos)
# The compositor, the bar, the quick-settings drawer and their support tools.

# --- compositor ---------------------------------------------------------------
hyprland
hyprpaper          # wallpaper daemon (reads config/hypr/hyprpaper.conf)
hypridle           # idle -> lock / dpms off / suspend (config/hypr/hypridle.conf)
hyprlock           # lock screen (config/hypr/hyprlock.conf)
hyprpicker         # colour picker, bound in keybinds
hyprland-qtutils   # native dialogs for permission/exit prompts
hyprpolkitagent    # polkit agent; conf.d/autostart.conf falls back to polkit-gnome

# --- shell surfaces -----------------------------------------------------------
waybar             # the floating status pill (config/waybar)
eww                # dock + quick-settings drawer + notification shade (config/eww)
rofi               # app drawer (config/rofi/continuity.rasi) and power menu
dunst              # Android-style heads-up notifications (config/dunst)
wlogout            # optional logout overlay, reachable from the power menu
swayosd            # on-screen volume/brightness popups (optional but very "mobile")

# --- terminals and files ------------------------------------------------------
foot
kitty
thunar
thunar-volman
tumbler            # thumbnailer for the file manager
gvfs
gvfs-mtp           # phone storage over USB, so a phone feels native
xdg-desktop-portal-hyprland

# --- toolkit glue -------------------------------------------------------------
gtk4
gtk3
libadwaita
qt5-wayland
qt6-wayland
qt6ct
