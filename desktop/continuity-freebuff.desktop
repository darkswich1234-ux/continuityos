[Desktop Entry]
Type=Application
Version=1.0
Name=Freebuff
GenericName=Coding Agent
Comment=Free coding agent — AppImage, CLI, or the web app
# Exec cannot use a shell: the wrapper below is explicit so the AppImage route,
# the AUR CLI route and the browser route can all be tried in order.
Exec=/bin/sh -c "if [ -x \"$HOME/Applications/Freebuff.AppImage\" ]; then exec \"$HOME/Applications/Freebuff.AppImage\"; elif [ -x \"$HOME/.local/bin/freebuff.AppImage\" ]; then exec \"$HOME/.local/bin/freebuff.AppImage\"; elif command -v freebuff >/dev/null 2>&1; then exec foot -e freebuff; else exec xdg-open https://freebuff.com; fi"
TryExec=/bin/sh
Icon=freebuff
Terminal=false
StartupNotify=true
Categories=Development;Utility;
Keywords=ai;agent;code;freebuff;
