/* ContinuityOS — app drawer (rofi).
 *
 *   rofi -show drun -theme ~/.config/rofi/continuity.rasi
 *
 * Material You, dark: one big rounded translucent card, pill search field,
 * icon grid. The palette is defined once in `*` and referenced with @name.
 */

* {
    /* palette */
    bg:            #0d0d11f2;
    surface:       #27262bf2;
    surface-2:     #343339f2;
    accent:        #a8c7fa;
    on-accent:     #08182d;
    fg:            #e6e1e5;
    muted:         #e6e1e5a8;
    faint:         #e6e1e55c;
    outline:       #e6e1e51f;
    danger:        #ffb4ab;

    /* base */
    background-color: transparent;
    text-color:       @fg;
    font:             "Inter Medium 12";
    border:           0px;
    margin:           0px;
    padding:          0px;
    spacing:          0px;
}

window {
    width:            760px;
    background-color: @bg;
    border:           1px solid;
    border-color:     @outline;
    border-radius:    28px;
    padding:          20px;
}

mainbox {
    children:  [ inputbar, listview ];
    spacing:   16px;
    padding:   0px;
}

/* ---------------- search field (pill) ---------------- */
inputbar {
    children:         [ prompt, entry ];
    background-color: @surface;
    border:           1px solid;
    border-color:     @outline;
    border-radius:    9999px;
    padding:          14px 20px;
    spacing:          12px;
}

prompt {
    background-color: transparent;
    text-color:       @accent;
    padding:          0px;
}

entry {
    background-color: transparent;
    text-color:       @fg;
    placeholder:      "Search apps";
    placeholder-color: @faint;
    cursor:           text;
    padding:          0px;
}

/* ---------------- app grid ---------------- */
listview {
    background-color: transparent;
    columns:          4;
    lines:            3;
    spacing:          14px;
    padding:          4px;
    scrollbar:        false;
    fixed-height:     true;
    fixed-columns:    true;
}

element {
    background-color: @surface;
    border:           1px solid;
    border-color:     @outline;
    border-radius:    24px;
    padding:          16px 10px;
    spacing:          10px;
}

element-icon {
    size:             48px;
    background-color: transparent;
    padding:          0px;
}

element-text {
    background-color: transparent;
    text-color:       @fg;
    highlight:        bold;
    padding:          0px;
    vertical-align:   0.5;
}

element.selected {
    background-color: @accent;
    border-color:     @accent;
}

element.selected element-text {
    text-color: @on-accent;
}

element.urgent {
    background-color: @surface-2;
    border-color:     @danger;
}

/* ---------------- scrollbar ---------------- */
scrollbar {
    handle-width:     6px;
    border-radius:    9999px;
    background-color: transparent;
    handle-color:     @faint;
}
