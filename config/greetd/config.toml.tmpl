# =============================================================================
#  ContinuityOS — greetd configuration (rendered from this template)
# =============================================================================
#  This file is the entire reason a ContinuityOS machine has no login prompt at
#  boot. greetd starts [initial_session] ONCE when it comes up, and that path
#  *bypasses the greeter completely*: the command below IS the desktop session.
#
#  [default_session] is therefore not the boot path at all. It is what appears
#  after you log out (or after the initial session exits on its own), which is
#  why the greeter is only ever the logout screen — and why a greeter that can
#  start any session is worth keeping: when the desktop is what broke, being
#  able to log in and repair it is the difference between a bad day and a
#  reinstall.
#
#  Rendered by `continuity-boot on|off`, which substitutes @VT@,
#  @GREETER_COMMAND@, @SESSION_COMMAND@ and @AUTOLOGIN_USER@, and which strips
#  the fenced block below for `off`. Edit this template (or use continuity-boot)
#  rather than /etc/greetd/config.toml: `on` renders that file from here again.
#
#  CAVEAT worth knowing before you debug session type: greetd does not set
#  XDG_SESSION_TYPE before PAM opens the session, so logind may record the
#  session as "unspecified" even though it is a Wayland session. Apps behave
#  because continuity-shell exports XDG_SESSION_TYPE=wayland itself; the
#  logind-level fix is a PAM/pam_env arrangement, documented in
#  docs/BOOT.md, and deliberately not done here (it would affect every session
#  greetd spawns, including the greeter).
# =============================================================================

[terminal]
# The virtual console greetd owns. 1 is the console a stock Arch install puts a
# login prompt on, so taking it is what removes that first login.
vt = @VT@
# Moving the active VT to greetd's own console would fight a boot splash for
# focus; the desktop claims its VT by itself a moment later either way.
switch = false

[default_session]
# THE LOGOUT SCREEN, not the boot path. `start-hyprland` is deliberately not
# here: a session launcher that a broken desktop cannot start is no recovery.
command = "@GREETER_COMMAND@"
user = "greeter"

# >>> continuity-autologin
[initial_session]
# Runs once when greetd starts. No greeter, no password, no session chooser:
# this is the "it just boots into ContinuityOS" line.
command = "@SESSION_COMMAND@"
user = "@AUTOLOGIN_USER@"
# <<< continuity-autologin
